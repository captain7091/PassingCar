@{
    Layout = $"";
}
@using PassingCarApis.Models
@model PaymentProofModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PassingCar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PassingCar.styles.css" asp-append-version="true" />
    <style>
        * {
            box-sizing: border-box;
        }

        /* Create two equal columns that floats next to each other */
        .column {
            float: left;
            width: 50%;
            padding: 10px;
            line-height: 1.3;
            height: 250px; /* Should be removed. Only for demonstration */
        }

        /* Create two equal columns that floats next to each other */
        .column_full {
            float: left;
            width: 100%;
            padding: 10px;
            height: 300px; /* Should be removed. Only for demonstration */
        }

        .column-1 {
            float: left;
            width: 50%;
            text-align: center;
            padding: 10px;
            line-height: 1.3;
            height: 250px; /* Should be removed. Only for demonstration */
        }

        .column-2 {
            float: left;
            width: 50%;
            padding: 10px;
            line-height: 1.4;
            height: 200px; /* Should be removed. Only for demonstration */
        }

        .background_blue {
            background-color: #82c6dd;
            border: 0px;
        }

        .background_light_blue {
            background-color: #cbecf3;
        }

        .align_right {
            text-align: right;
        }

        .align_center {
            text-align: center;
        }

        .column-3 {
            float: left;
            width: 50%;
            text-align: left;
            padding: 10px 0px 10px 80px;
            height: 200px; /* Should be removed. Only for demonstration */
        }

        /* Clear floats after the columns */
        .row:after {
            content: "";
            display: table;
            clear: both;
        }

        table {
            width: 100%;
            padding: 0px;
        }

        .column_1 {
            width: 60%;
            text-align: left;
        }

        .column_2 {
            width: 30%;
            text-align: center;
        }

        .column_3 {
            width: 10%;
            text-align: center;
        }

        .spacing {
            height: 50px;
        }

        table tr {
        }

        table th {
            padding: 15px;
        }

        table td {
            padding: 10px;
        }

        .font_arial {
            font-family: arial;
        }

        .font_calibri {
            font-family: calibri;
        }

        img {
            max-width: 100%;
            max-height: 100%;
        }

        .borderless td, .borderless th {
            border: none !important;
        }

        html {
            padding: 40px 5px 40px 5px;
        }
    </style>
</head>
<body>
    <div class="row">
        <div class="column">
            <h2 style="color:#1f91da" class="font_arial">FACTURA</h2>
            <p class="font_calibri">
                @Model.ClientName <br />
                @Model.Address <br />
                @Model.City, @Model.State, @Model.ZipCode <br />
                Telefon: @Model.PhoneNumer <br />
                @if (!string.IsNullOrEmpty(Model.NIF))
                {
                    <b>NIF.#:</b> @Model.NIF <br />
                }
                @if (!string.IsNullOrEmpty(Model.DNI))
                {
                    <b>DNI.#:</b> @Model.DNI <br />
                } <br />
                @*@Model. <br />*@
            </p>
        </div>     
    </div>
    <div class="row">
        <div class="column-3">
            <h3><br /></h3>
            <h3 class="font_arial">No. FACTURA: @Model.NoFactura</h3>
            <p class="font_calibri"><b>Data:  </b> @Model.CreateDate <br /></p>
        </div>
        <div class="column_full">
            <table class="font_calibri table borderless">
                <tr class="background_blue">
                    <th class="column_1">DESCRIPTION</th>
                    <th class="column_2">CANTIDAD</th>
                    <th class="column_3">PRECIO</th>
                </tr>
                <tr>
                    <td class="background_light_blue">
                        <b>Transporte de Paquetes PassingCar</b><br/>
                        Origin: @Model.Origin <br />
                        Destino: @Model.Destination <br />
                    </td>
                    <td class="background_light_blue"></td>
                    <td class="align_center"><b>@Model.RestClientPrice €</b></td>
                </tr>            
                    <td colspan="2" class="background_blue align_right">TOTAL</td>
                <td class="align_center"><b>@Model.RestClientPrice €</b></td>
                </tr>
                <tr class="spacing">
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="3" class="background_light_blue">Pagado mediante tarjeta de debito</td>
                </tr>
                <tr class="spacing">
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>