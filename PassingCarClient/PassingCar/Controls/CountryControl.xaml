<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    
    xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar"
    x:Class="PassingCar.Controls.CountryControl">
    <ContentView.Content>
        <StackLayout Orientation="Horizontal">

            <Image x:Name="FlagImage"
                          HeightRequest="26" 
                          WidthRequest="26" />
    <Label x:Name="CountryNameLabel"
           Margin="12,0"
           FontSize="{markups:OnScreenSize DefaultSize='18' , Small='16', Medium='16',  ExtraSmall='14'}"
           VerticalOptions="Center"
           HorizontalOptions="FillAndExpand"/>
    <Label x:Name="CountryCodeLabel"
           FontSize="{markups:OnScreenSize DefaultSize='18' , Small='16', Medium='16',  ExtraSmall='14'}"
           VerticalOptions="Center"
           HorizontalTextAlignment="End"/>
        </StackLayout>

    </ContentView.Content>
    
</ContentView>
