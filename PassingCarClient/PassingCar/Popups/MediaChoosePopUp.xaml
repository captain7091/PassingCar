<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
    BackgroundColor="Transparent"
    HeightRequest="100"
    WidthRequest="200"
    x:Class="PassingCar.Popups.MediaChoosePopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar"
    xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:utils="clr-namespace:PassingCar.Utils"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <utils:NeatFrame
        BackgroundColor="White"
        BorderColor="Transparent"
        CornerRadius="20"
        HeightRequest="250"
        Margin="20"
        Padding="10">
        <StackLayout Orientation="Vertical">
            <utils:NeatFrame
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                CornerRadius="25"
                HorizontalOptions="EndAndExpand"
                Margin="0,10,10,0"
                Padding="0">
                <Image
                    Aspect="AspectFit"
                    BackgroundColor="Transparent"
                    HeightRequest="15"
                    HorizontalOptions="CenterAndExpand"
                    Margin="0,0,0,0"
                    Source="x_symbol.png"
                    VerticalOptions="CenterAndExpand"
                    x:Name="menu_context" />
                <utils:NeatFrame.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="Close_PopUp" />
                </utils:NeatFrame.GestureRecognizers>
            </utils:NeatFrame>
            <Label
                HorizontalOptions="CenterAndExpand"
                Margin="0,20,0,0"
                Text="Subir Foto Desde:"
                VerticalOptions="Center" />
            <Button
                BackgroundColor="#FE3F40"
                CharacterSpacing="0"
                Clicked="SelectCamera"
                CornerRadius="15"
                FontFamily="RajSemiBold"
                FontSize="{markups:OnScreenSize DefaultSize='14',
                                                Small='12',
                                                Medium='12',
                                                ExtraSmall='10'}"
                HeightRequest="35"
                HorizontalOptions="CenterAndExpand"
                Margin="0,30,0,0"
                Text="CÁMARA"
                TextColor="White"
                VerticalOptions="Center" />
            <Button
                BackgroundColor="#FE3F40"
                CharacterSpacing="0"
                Clicked="SelectGallery"
                CornerRadius="15"
                FontFamily="RajSemiBold"
                FontSize="{markups:OnScreenSize DefaultSize='14',
                                                Small='12',
                                                Medium='12',
                                                ExtraSmall='10'}"
                HeightRequest="35"
                HorizontalOptions="CenterAndExpand"
                Margin="0,10,0,50"
                Text="GALERÍA"
                TextColor="White"
                VerticalOptions="Center" />
        </StackLayout>
    </utils:NeatFrame>
</mopups:PopupPage>