<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PassingCar.Extensions"         
             x:Class="PassingCar.Views.LoginInput"
             xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar"
             Title="PassingCar - Login" 
             Padding="0, 0, 0, 0"
             BackgroundColor="white">
    <!--xmlns:controls="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"-->

    <ContentPage.Content>
        <Grid HorizontalOptions="Fill">
            <Grid BackgroundColor="Transparent" HorizontalOptions="Center">
                <ScrollView>
                    <Grid Margin="0,20,0,0" VerticalOptions="Start" HorizontalOptions="Center"
                    BackgroundColor="Transparent"
                    RowSpacing="15"
                    Padding="0, 0, 0, 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <BoxView Grid.Row="0"
                        HeightRequest="10"
                        Color="White"
                        WidthRequest="45"
                        VerticalOptions="Center"/>

                        <Image Grid.Row="1" HeightRequest="200" WidthRequest="200"
                        BackgroundColor="Transparent"
                        Source="logo_login_xs.png"
                        Aspect="AspectFill" />

                        <BoxView Grid.Row="2"
                        HeightRequest="10"
                        Color="white"
                        WidthRequest="45"
                        VerticalOptions="Center"/>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Entry Grid.Column="0"
                            x:Name="login_email_phone"
                            Text="{Binding EmailPhoneNumber}"
                            Placeholder="Email/Número de teléfono"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            FontFamily="RejRegular"
                            Margin="0"
                            CharacterSpacing="1"
                            ClearButtonVisibility="Never"
                            TextChanged="login_email_phone_TextChanged"
                            ReturnType="Next"
                            >
                                <Entry.Keyboard>
                                    <Keyboard x:FactoryMethod="Create">
                                        <x:Arguments>
                                            <KeyboardFlags>Suggestions</KeyboardFlags>
                                        </x:Arguments>
                                    </Keyboard>
                                </Entry.Keyboard>
                            </Entry>

                            <ImageButton Grid.Column="1" x:Name="emailCross" Source="cross.png" HeightRequest="35" WidthRequest="35" IsVisible="False" HorizontalOptions="Start" VerticalOptions="Center" Padding="5" Margin="10,0,0,0" Clicked="emailCross_Clicked"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Entry
                                x:Name="login_password"
                                Placeholder="Contraseña"
                                Text="{Binding Password}"
                                IsPassword="True"
                                FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                                FontFamily="RejRegular"
                                Margin="0"
                                CharacterSpacing="1"
                                ClearButtonVisibility="Never"
                                TextChanged="login_password_TextChanged"
                                ReturnType="Done"/>

                                <ImageButton x:Name="passwordEye" Source="close_eye.png" HeightRequest="40" WidthRequest="40" IsVisible="True" HorizontalOptions="End" VerticalOptions="Center" Padding="8" Margin="0,0,5,0" Clicked="passwordEye_Clicked"/>
                            </Grid>

                            <ImageButton Grid.Column="1" x:Name="passwordCross" Source="cross.png" HeightRequest="35" WidthRequest="35" IsVisible="False" HorizontalOptions="Start" VerticalOptions="Center" Padding="5" Margin="10,0,0,0" Clicked="passwordCross_Clicked"/>

                        </Grid>

                        <BoxView Grid.Row="5"
                        HeightRequest="10"
                        Color="White"
                        WidthRequest="45"
                        VerticalOptions="Center"/>

                        <Button Grid.Row="6" x:Name="SignInBTN"
                        HorizontalOptions="Center"
                            WidthRequest="150"
                            HeightRequest="35"
                            TextColor="White"
                        CornerRadius="15"
                            FontFamily="RajSemiBold"
                            BackgroundColor="#FE3F40"
                        Text="Iniciar sesión"
                        FontSize="{markups:OnScreenSize DefaultSize='14' , Small='10', Medium='12',  ExtraSmall='10'}"
                        CharacterSpacing="1"
                        Command="{Binding LoginCommand}"></Button>

                        <Grid Grid.Row="7"
                        Padding="0, 15, 0, 0"
                        HorizontalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <BoxView Grid.Column="0"
                            HeightRequest="1"
                            Color="LightGray"
                            WidthRequest="45"
                            VerticalOptions="Center" />

                            <Label Grid.Column="1"
                            Text=" O continúa con "
                            VerticalOptions="Center"
                            FontAttributes="Bold"
                            FontFamily="RejSemiBold"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            CharacterSpacing="0"
                            TextColor="#41394e"
                            HorizontalOptions="Center" />

                            <BoxView Grid.Column="2"
                            HeightRequest="1"
                            Color="LightGray"
                            WidthRequest="45"
                            VerticalOptions="Center" />

                        </Grid>

                        <Grid Grid.Row="8"
                        HorizontalOptions="Center"
                        Margin="0,10,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                            Source="facebook_logo.png"
                            HorizontalOptions="End"
                            Margin="0,0,15,0"
                            WidthRequest="40"
                            HeightRequest="40"
                            VerticalOptions="Center"
                            Aspect="AspectFit" >
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LoginFacebookCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Grid.Column="1"
                            Source="apple_logo.png"
                            Margin="15,0,15,0"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Aspect="AspectFit"
                             IsVisible="{Binding IsAppleLogoVisible}"
                            >
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LoginAppleCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Grid.Column="2"
                            Source="google_logo.png"
                            Margin="15,0,0,0"
                            WidthRequest="40"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Aspect="AspectFit"
                            >
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LoginGoogleCommand}" />
                                </Image.GestureRecognizers>
                            </Image>

                        </Grid>

                        <!-- Spacer to push register/forgot password to bottom -->
                        <BoxView Grid.Row="9" Color="Transparent" VerticalOptions="FillAndExpand" />
                    </Grid>
                </ScrollView>
                <Grid VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0"
                    Text="Regístrate"
                    FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                    FontAttributes="Bold"
                    FontFamily="RejSemiBold"
                    HorizontalOptions="Center"
                    TextColor="#41394e"
                    Margin="0, 0, 0, 5"
                    VerticalOptions="Center" BackgroundColor="White" >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RegisterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Row="1"
                        Text="¿Has olvidado tu contraseña?"
                        IsVisible="True"
                        FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                        FontAttributes="Bold"
                        FontFamily="RejSemiBold"
                        HorizontalOptions="Center"
                        TextColor="#41394e"
                        Margin="0, 5, 0, 0"
                        VerticalOptions="Center" BackgroundColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                        </Label.GestureRecognizers>
                        <Label.Padding>
                            <OnPlatform x:TypeArguments="Thickness">
                                <OnPlatform.Platforms>
                                    <On Platform="iOS" Value="0, 0, 0, 0" />
                                    <On Platform="Android" Value="0, 0, 0, 0" />
                                    <On Platform="UWP" Value="0, 0, 0, 0" />
                                </OnPlatform.Platforms>
                            </OnPlatform>
                        </Label.Padding>
                    </Label>
                </Grid>
            </Grid>

            <!-- Single loading indicator overlay -->
            <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000" 
                  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <ActivityIndicator IsRunning="{Binding Loading}" 
                                 VerticalOptions="Center" HorizontalOptions="Center" 
                                 Color="#FE3F40" Scale="1.5" />
            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>