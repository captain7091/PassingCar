<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PassingCar.Extensions"
             xmlns:behavior="clr-namespace:PassingCar.Behaviors"
             xmlns:behaviors="clr-namespace:PassingCar.Extensions.Behaviors"
            
              xmlns:utils="clr-namespace:PassingCar.Utils"
             x:Class="PassingCar.Views.MyAccountPage"
             xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar" 
             BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="baseStyle"
             TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="Micro" />
                <Setter Property="FontAttributes" Value="Italic" />
            </Style>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleImage"
                                              x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style TargetType="Image">
                        <Setter Property="HeightRequest" Value="20" />
                        <Setter Property="Source" Value="{local:EmbeddedImage fileName=error.png}" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>
                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style TargetType="Image">
                        <Setter Property="HeightRequest" Value="20" />
                        <Setter Property="Source" Value="{local:EmbeddedImage fileName=success.png}" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>
            </behaviors:BooleanToObjectConverter>



            <behaviors:BooleanToObjectConverter x:Key="boolToStyleEmail"
                                           x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style TargetType="Label" BasedOn="{StaticResource baseStyle}">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="Enter a valid email" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style TargetType="Label" BasedOn="{StaticResource baseStyle}">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="Your email looks good." />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStylePassword"
                                           x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style TargetType="Label" BasedOn="{StaticResource baseStyle}">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="Minim 8 characters.Please use special ch!" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style TargetType="Label" BasedOn="{StaticResource baseStyle}">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="Your password looks good." />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <Style x:Key="InvalidEntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="Red" />
            </Style>

            <Style x:Key="InvalidLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="Red" />
            </Style>

            <Style x:Key="ValidEntryStyle"
               TargetType="Entry">
                <Setter Property="TextColor" Value="Gray"/>
                <Setter Property="Text" Value="Eres muy joven!" />
            </Style>

            <Style x:Key="ValidLabelStyle"
               TargetType="Label">
                <Setter Property="TextColor" Value="Green"/>
                <Setter Property="Text" Value="Eres muy joven!" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <AbsoluteLayout BackgroundColor="Transparent" x:Name="myaccount_page">
            <ScrollView Margin="0,0,0,0" Padding="0,90,0,50" AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All" 
                        x:Name="myscrollview" Scrolled="OnScrolled"
                        BackgroundColor="Transparent">
                <Grid 
                  BackgroundColor="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackLayout
                Grid.Column="0" Grid.Row="1"
                Margin="30,0,0,0"
                BackgroundColor="Transparent"
                Orientation="Vertical"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="CenterAndExpand"
                >
                        <Frame HeightRequest="60" VerticalOptions="Start"
                               WidthRequest="60"
                               CornerRadius="30"
                               HorizontalOptions="Start"
                               IsClippedToBounds="True"
                               Padding="0"
                               BorderColor="Gray"
                               Margin="0,0,0,0">
                        <Image 
                         x:Name="profile_photo"  
                       
                        Source="{local:EmbeddedImage fileName=img_account.png}"
                        HeightRequest="60"
                        WidthRequest="60"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Margin="0,0,0,0">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer
                             Tapped="InsertPhotoClicked"
                             NumberOfTapsRequired="1" />
                            </Image.GestureRecognizers>
                        </Image>
                            </Frame>
                        <!--Source="{Binding ProfileImageSource}"-->
                        <Label 
                        x:Name="profile_name"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Padding="0,10,0,0"
                        VerticalOptions="Center"
                        Margin="0,0,0,0"
                        FontSize="{markups:OnScreenSize DefaultSize='18' , Small='16', Medium='16',  ExtraSmall='14'}"
                        TextColor="Black"
                        FontFamily="RajBold"
                        Text="No name"/>
                        <!--Text="{Binding UserName}"-->
                    </StackLayout>
                    <StackLayout
                Grid.Column="1" Grid.Row="1"
                Margin="0,0,50,0"
                BackgroundColor="Transparent"
                Orientation="Vertical"
                HorizontalOptions="EndAndExpand"
                VerticalOptions="CenterAndExpand"
                >
                        <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand" Padding="0,0,0,0" Spacing="0">
                            <Label
                                HorizontalOptions="CenterAndExpand"
                                FontFamily="RajBold"
                                Text="64%" 
                                FontSize="{markups:OnScreenSize DefaultSize='20' , Small='18', Medium='18',  ExtraSmall='16'}"
                                Margin="0,0,0,0"></Label>
                            <ProgressBar BackgroundColor="Transparent"  Progress="0.64"  
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="StartAndExpand"
                                     HeightRequest="10"/>
                        </StackLayout>

                        <!--Source="{Binding ProfileImageSource}"-->
                        <Label 
                        BackgroundColor="Transparent"
                        HorizontalOptions="EndAndExpand"
                        HorizontalTextAlignment="End"
                        Padding="0,0,0,0"
                        VerticalOptions="Center"
                        Margin="0,0,0,0"
                        FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                        TextColor="Black"
                        FontFamily="RajSemiBold"
                        Text="Estado de Registro"/>
                        <!--Text="{Binding UserName}"-->
                    </StackLayout>
                    <StackLayout 
                    Margin="0,10,0,10"
                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Vertical" Padding="30,10,30,10" Spacing="0">
                        <utils:NeatFrame
                    CornerRadius="10"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    Margin="40,0,40,0"
                    Padding="20,5,20,5"
                    BorderColor="Transparent"
                    IsClippedToBounds="True"
                    BackgroundColor="LightGray">
                            <StackLayout Orientation="Horizontal"
                                 HorizontalOptions="CenterAndExpand"
                                 VerticalOptions="CenterAndExpand">
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer 
                                    />
                                </StackLayout.GestureRecognizers>
                                <Label
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,0"
                               FontFamily="RajBold"
                               FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                               HorizontalOptions="Center"
                               VerticalOptions="CenterAndExpand">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span                          
                                            FontFamily="RajBold"
                                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                                        Text="!!! " TextColor="#f81a21"/>
                                            <Span 
                                            FontFamily="RajBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                                        Text="Por favor, revisa tu email" TextColor="#44394a"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </StackLayout>
                        </utils:NeatFrame>
                    </StackLayout>

                    <StackLayout
                    Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Vertical" Padding="0,0,0,0" Spacing="0">
                        <Label
                               x:Name="login_type_content"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,0"
                               FontFamily="RajBold"
                               FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                               HorizontalOptions="Center"
                               VerticalOptions="CenterAndExpand">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span                          
                                    FontFamily="RajBold"
                                    FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                                    Text="Te registraste con:  " TextColor="Black"/>
                                    <Span
                                    x:Name="login_type"
                                    FontFamily="RajBold"
                                    FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                                    Text="FACEBOOK/GOOGLE" TextColor="#44394a"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>
                    <utils:NeatFrame
                    Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    CornerRadius="20"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    Margin="0,20,0,20"
                    Padding="50,20,50,20"
                    BorderColor="Transparent"
                    IsClippedToBounds="True"
                    BackgroundColor="LightGray">
                        <StackLayout                  
                        Orientation="Vertical" Padding="0,0,0,0" Spacing="0">
                            <Label 
                        Text="Tu calificación: "
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,10"
                        FontFamily="RajBold"
                        FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                        HorizontalOptions="Center"
                        VerticalOptions="CenterAndExpand">
                            </Label>
                            <StackLayout Margin="0,5,0,0" BackgroundColor="Transparent" Orientation="Horizontal" HorizontalOptions="CenterAndExpand" VerticalOptions="Center">
                                <Image HeightRequest="12" x:Name="RatingStar1" BackgroundColor="Transparent" Source="{local:EmbeddedImage fileName=a_star1.png}" Aspect="AspectFit" />
                                <Image HeightRequest="12" x:Name="RatingStar2" BackgroundColor="Transparent" Source="{local:EmbeddedImage fileName=a_star1.png}" Aspect="AspectFit" />
                                <Image HeightRequest="12" x:Name="RatingStar3" BackgroundColor="Transparent" Source="{local:EmbeddedImage fileName=a_star1.png}" Aspect="AspectFit" />
                                <Image HeightRequest="12" x:Name="RatingStar4" BackgroundColor="Transparent" Source="{local:EmbeddedImage fileName=a_star1.png}" Aspect="AspectFit" />
                                <Image HeightRequest="12" x:Name="RatingStar5" BackgroundColor="Transparent" Source="{local:EmbeddedImage fileName=a_star1.png}" Aspect="AspectFit" />
                            </StackLayout>
                            <Label
                        x:Name="RatingValue"
                        Text="No reseñas"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"
                        Margin="0,5,0,0"
                        FontFamily="RajBold"
                       FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                        HorizontalOptions="Center"
                        VerticalOptions="CenterAndExpand">
                            </Label>
                        </StackLayout>
                    </utils:NeatFrame>

                    <Label
                        Grid.Row="5" Grid.Column="0"
                        Margin="20,20,0,20"
                        HorizontalOptions="StartAndExpand"
                        Text="Información de la Cuenta"
                        FontSize="{markups:OnScreenSize DefaultSize='16' , Small='10', Medium='12',  ExtraSmall='10'}"
                        FontFamily="RajBold"
                        BackgroundColor="Transparent"
                        >

                    </Label>
                    <Image Grid.Row="5" Grid.Column="1"
                           Margin="0,20,20,20"
                           Source="{local:EmbeddedImage fileName=line_range.png}"
                           HeightRequest="1"
                           Aspect="AspectFill"
                           VerticalOptions="CenterAndExpand"
                           BackgroundColor="Transparent">

                    </Image>

                    <StackLayout Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,0,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            x:Name="account_number_head"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            Text="Número de teléfono:">
                        </Label>
                        <Entry
                            IsEnabled="False"
                            x:Name="account_number"
                            Placeholder="no number" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            WidthRequest="160"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding PhoneNumber}"
                        />
                    </StackLayout>

                    <StackLayout Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,10,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            x:Name="account_email_head"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            Text="Email:">
                        </Label>
                        <Entry
                            x:Name="account_email"
                            Placeholder="no email" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            WidthRequest="160"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding Email}"
                        >
                            <Entry.Behaviors>
                                <behaviors:EmailValidatorBehavior x:Name="account_validator_email"/>
                            </Entry.Behaviors>
                           
                        </Entry>
                    </StackLayout>

                    <StackLayout Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,0,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            x:Name="account_re_email_head"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            Text="Confirmar email:">
                        </Label>
                        <Entry
                            x:Name="account_re_email"
                            Placeholder="Insertar email" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            WidthRequest="160"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding ConfirmEmail}"
                        >
                            <Entry.Behaviors>
                                <behaviors:EmailValidatorBehavior/>
                            </Entry.Behaviors>
                           
                        </Entry>
                    </StackLayout>

                    <StackLayout Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,10,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            x:Name="account_oldpassword_head"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            Text="Contraseña: ">
                        </Label>
                        <Entry
                            x:Name="account_oldpassword"
                            IsPassword="True"
                            Placeholder="************************" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            WidthRequest="160"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding Password}"
                        >
                            <Entry.Behaviors>
                                <behavior:PasswordVaildBehavior 
                                                     
                                                      IsValid="False"
                                                      MaximumLength="40"
                                                      MinimumLength="8" 
                                                      x:Name="old_password"/>
                            </Entry.Behaviors>

                           
                        </Entry>
                    </StackLayout>

                    <StackLayout Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,0,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            x:Name="account_newpassword_head"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            Text="Nueva Contraseña: ">
                        </Label>
                        <Entry
                            x:Name="account_newpassword"
                            IsPassword="True"
                            Placeholder="" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            WidthRequest="160"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding NewPassword}"
                        >
                            <Entry.Behaviors>
                                <behavior:PasswordVaildBehavior 
                                                      
                                                      IsValid="False"
                                                      MaximumLength="40"
                                                      MinimumLength="8"
                                                      x:Name="new_password"/>
                            </Entry.Behaviors>

                           
                        </Entry>
                    </StackLayout>

                    <StackLayout Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,0,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            x:Name="account_repassword_head"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            Text="Repetir Contraseña: ">
                        </Label>
                        <Entry
                            x:Name="account_repassword"
                            IsPassword="True"
                            Placeholder="" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            WidthRequest="160"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding Password}"
                        >
                            <Entry.Behaviors>
                                <behavior:PasswordVaildBehavior 
                                                      
                                                      IsValid="False"
                                                      MaximumLength="40"
                                                      MinimumLength="8"
                                                      x:Name="re_password"/>
                            </Entry.Behaviors>

                            
                        </Entry>
                    </StackLayout>

                    <StackLayout Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,0,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Button                            
                            Margin="0, 25, 0, 25"
                            WidthRequest="150"
                            Text="ACTUALIZAR CUENTA"
                            TextColor="White"
                            CharacterSpacing="0"
                            FontFamily="RajSemiBold"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12',  ExtraSmall='10'}"
                            CornerRadius="15"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="CenterAndExpand"
                            BackgroundColor="#FE3F40"
                            HeightRequest="35"
                            Clicked="Update_account"
                            />
                    </StackLayout>

                    <Label
                        Grid.Row="13" Grid.Column="0"
                        Margin="20,20,0,20"
                        HorizontalOptions="StartAndExpand"
                        Text="Información General"
                        FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                        FontFamily="RajBold"
                        BackgroundColor="Transparent"
                        >

                    </Label>
                    <Image Grid.Row="13" Grid.Column="1"
                           Margin="0,20,20,20"
                           Source="{local:EmbeddedImage fileName=line_range.png}"
                           HeightRequest="1"
                           Aspect="AspectFill"
                           VerticalOptions="CenterAndExpand"
                           BackgroundColor="Transparent">

                    </Image>

                    <Entry
                        x:Name="general_firstname"
                        Keyboard="Text"
                        Margin="40,0,0,10"
                        Grid.Row="14" Grid.Column="0"
                        Placeholder="*First Name" 
                        FontFamily="RajSemiBold"
                        FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                        Text="{Binding FirstName}"
                    />
                    <Entry
                        x:Name="general_lastname"
                        Keyboard="Text"
                        Margin="0,0,40,10"
                        Grid.Row="14" Grid.Column="1"
                        Placeholder="*Last Name" 
                        FontFamily="RajSemiBold"
                        FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                        Text="{Binding LastName}"
                    />

                    <StackLayout Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,0,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            x:Name="general_address_head"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            Text="Dirección Completa: ">
                        </Label>
                        <Entry
                            x:Name="general_address"
                            Placeholder="Address Line 1" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            WidthRequest="160"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding Address}"
                        />
                    </StackLayout>
                    <StackLayout Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="40,0,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Entry
                            x:Name="general_address2"
                            Placeholder="Address Line 2" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            WidthRequest="160"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding Address2}"
                        />
                    </StackLayout>
                    <StackLayout Grid.Row="17" Grid.Column="0"
                                 Margin="40,0,10,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16' , Small='14', Medium='14',  ExtraSmall='12'}"
                            Text="Ciudad: ">
                        </Label>
                        <Entry
                            x:Name="general_city"
                            Placeholder="xxxxx" 
                            FontFamily="RajSemiBold"
                            HorizontalOptions="FillAndExpand"
                            Margin="0, 0, 0, 0"
                            FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                            Text="{Binding City}"
                        />
                    </StackLayout>
                    <StackLayout Grid.Row="17" Grid.Column="1"
                                 Margin="10,0,40,0"
                                 HorizontalOptions="FillAndExpand"
                                 Orientation="Horizontal">
                        <Label
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="Start"
                            FontFamily="RajBold"
