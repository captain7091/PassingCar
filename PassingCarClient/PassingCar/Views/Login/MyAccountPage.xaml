                HorizontalTextAlignment="Center"
                HorizontalOptions="EndAndExpand"
                FontSize="25"
                TextColor="#b4b4b1"
                FontFamily="RajBold"
                >
                <Label.Margin>
                    <OnPlatform x:TypeArguments="Thickness">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="0, 0, 20, 0" />
                            <On Platform="Android" Value="0, 40, 0, 0" />
                            <On Platform="UWP" Value="0, 0, 40, 0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </Label.Margin>
            </Label>
            <Grid AbsoluteLayout.LayoutBounds="0, 1, 1, AutoSize" AbsoluteLayout.LayoutFlags="YProportional,WidthProportional"
                         VerticalOptions="CenterAndExpand" BackgroundColor="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border x:Name="up_context_image" 
                                   Margin="0,10,0,0"
                                   Grid.Column="1" VerticalOptions="FillAndExpand" 
                                   HorizontalOptions="CenterAndExpand"  
                                   BackgroundColor="LightGray" 
                                  
                                   Padding="20, 15, 20, 15" >
                    <Image    
                            x:Name="up_context"
                            HeightRequest="15"
                            Margin="0,0,0,0"                       
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="CenterAndExpand"
                            BackgroundColor="Transparent"
                            Source="{local:EmbeddedImage fileName=up__arrow_white.png}"
                            Aspect="AspectFit"
                            >
                    </Image>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                                Tapped="ScrollUp"
                                NumberOfTapsRequired="1" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle  CornerRadius="25,25,0,0" />

                    </Border.StrokeShape>
                </Border>
                <Border 
                    x:Name="help_context"
                    HorizontalOptions="EndAndExpand"
                    Margin="0, 0, 0, 10"
                    BackgroundColor="LightGray"  Padding="10, 12.5, 10, 12.5" Grid.Column="2">
                    <Image
                        x:Name="help_image_context"
                        Margin="10,0,10,0"
                        VerticalOptions="CenterAndExpand"
                        HorizontalOptions="EndAndExpand"
                        BackgroundColor="Transparent"
                        Source="{local:EmbeddedImage fileName=help_icon.png}"
                        HeightRequest="25"
                        WidthRequest="25"
                        Aspect="AspectFit"
                        >
                    </Image>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25,0,25,0"/>

                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                                Tapped="GoHelpPage"
                                NumberOfTapsRequired="1" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>