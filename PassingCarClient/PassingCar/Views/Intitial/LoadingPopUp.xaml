<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
     xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups" 
   xmlns:mopupsanim="clr-namespace:Mopups.Animations;assembly=Mopups"
              xmlns:views="clr-namespace:PassingCar.Views" xmlns:local="clr-namespace:PassingCar.Extensions" xmlns:utils="clr-namespace:PassingCar.Utils"
          
             x:Class="PassingCar.Views.Intitial.LoadingPopUp" >
     <utils:NeatFrame CornerRadius="20" Background="Transparent" Padding="10" BorderColor="Transparent" HeightRequest="180" WidthRequest="200">
        <Grid BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image BackgroundColor="Transparent" 
                Grid.Row="0"
                VerticalOptions="Center"
                HorizontalOptions="CenterAndExpand" 
                Source="{local:EmbeddedImage fileName=passingcar_default.png}" Aspect="AspectFit" />
            <ActivityIndicator Grid.Row="1" Height="20" IsRunning="True"></ActivityIndicator>
            <!-- <views:LoadingSmall Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center"/> -->
        </Grid>
    </utils:NeatFrame>

</mopups:PopupPage>