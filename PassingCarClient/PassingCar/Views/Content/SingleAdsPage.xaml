                                                        FontFamily="RajSemiBold"
                                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                                        Small='12',
                                                                                        Medium='12',
                                                                                        ExtraSmall='10'}"
                                                        Text="€"
                                                        TextColor="#44394a"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Column="1"
                                                    Grid.Row="1"
                                                    IsVisible="{Binding NewOfferVisibility}">
