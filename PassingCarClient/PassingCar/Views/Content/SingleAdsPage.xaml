                                                        FontFamily="RajSemiBold"
                                                        FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                        Small='10',
                                                                                        Medium='10',
                                                                                        ExtraSmall='10'}"
                                                        HeightRequest="35"
                                                        Margin="0,10,0,0"
                                                        Padding="5,0"
                                                        Text="ENVIAR CONTRAOFERTA"
                                                        TextColor="#ffffff"
                                                        VerticalOptions="Center"
                                                        WidthRequest="150"
                                                        x:Name="button_offer" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Column="1"
                                                    Grid.Row="2"
                                                    IsVisible="{Binding NewOfferVisibility}">
