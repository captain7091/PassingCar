                                                FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                                Small='12',
                                                                                Medium='12',
                                                                                ExtraSmall='10'}"
                                                HorizontalOptions="Start"
                                                Padding="20,10,20,10"
                                                Text="{Binding OffersHeader}"
