<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    BackgroundColor="White"
    Padding="0"
    x:Class="PassingCar.Views.Content.SingleAdsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:behaviors="clr-namespace:PassingCar.Extensions.Behaviors"
    xmlns:controls="clr-namespace:PassingCar.Controls"
    xmlns:local="clr-namespace:PassingCar.Extensions"
    xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar"
    xmlns:utils="clr-namespace:PassingCar.Utils"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <ContentPage.Content>
        <AbsoluteLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <ScrollView
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                Scrolled="OnScrolled"
                VerticalScrollBarVisibility="Never"
                x:Name="myscrollview">
                <StackLayout
                    BackgroundColor="Transparent"
                    Margin="0"
                    Padding="0"
                    Spacing="0">
                    <StackLayout
                        BackgroundColor="Transparent"
                        HeightRequest="300"
                        Margin="0"
                        Padding="0">
                        <CarouselView
                            HorizontalOptions="FillAndExpand"
                            IndicatorView="{x:Reference carouselIndicator}"
                            ItemsSource="{Binding CarouselItems}">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Image
                                        Aspect="AspectFill"
                                        BackgroundColor="Transparent"
                                        HeightRequest="300"
                                        HorizontalOptions="FillAndExpand"
                                        Source="{Binding ImageSource}" />
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>
                        <IndicatorView
                            HeightRequest="0"
                            HorizontalOptions="FillAndExpand"
                            IndicatorColor="LightGray"
                            IndicatorsShape="Square"
                            Margin="0,0,0,0"
                            SelectedIndicatorColor="Gray"
                            VerticalOptions="FillAndExpand"
                            WidthRequest="0"
                            x:Name="carouselIndicator" />
                    </StackLayout>
                    <StackLayout
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        Margin="0"
                        Padding="0"
                        VerticalOptions="FillAndExpand">
                        <utils:NeatFrame
                            BackgroundColor="White"
                            BorderColor="Transparent"
                            CornerRadius="20"
                            Margin="0,-25,0,0"
                            Padding="0"
                            VerticalOptions="FillAndExpand">
                            <StackLayout Margin="0" Padding="0">
                                <StackLayout Orientation="Horizontal">
                                    <Label
                                        BackgroundColor="Transparent"
                                        FontFamily="RajRegular"
                                        FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                        Small='10',
                                                                        Medium='10',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="StartAndExpand"
                                        Margin="0"
                                        Padding="20,20,0,0"
                                        Text="{Binding AdsDetails.PostedTime, Converter={StaticResource cnvDateTimeConverter}}"
                                        TextColor="#44394a"
                                        VerticalOptions="StartAndExpand" />

                                    <utils:NeatFrame
                                        BackgroundColor="White"
                                        BorderColor="Transparent"
                                        CornerRadius="15"
                                        Margin="0,15,0,0"
                                        Padding="5"
                                        VerticalOptions="StartAndExpand">
                                        <Image
                                            Aspect="AspectFit"
                                            BackgroundColor="Transparent"
                                            HeightRequest="20"
                                            HorizontalOptions="End"
                                            Source="{local:EmbeddedImage fileName=share_empty.png}"
                                            VerticalOptions="StartAndExpand" />
                                        <utils:NeatFrame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShareCommand}" />
                                        </utils:NeatFrame.GestureRecognizers>
                                    </utils:NeatFrame>
                                    <utils:NeatFrame
                                        BackgroundColor="White"
                                        BorderColor="Black"
                                        CornerRadius="15"
                                        Margin="0,15,20,0"
                                        Padding="5"
                                        VerticalOptions="StartAndExpand">
                                        <Image
                                            Aspect="AspectFit"
                                            BackgroundColor="Transparent"
                                            HeightRequest="20"
                                            HorizontalOptions="End"
                                            Source="{Binding IsFavorite, Converter={StaticResource FavoriteImageConverter}}"
                                            VerticalOptions="StartAndExpand"
                                            x:Name="FavImage">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding FavoriteImageSingle}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </utils:NeatFrame>
                                </StackLayout>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='16',
                                                                        Small='14',
                                                                        Medium='14',
                                                                        ExtraSmall='12'}"
                                        Grid.Row="0"
                                        HorizontalTextAlignment="Start"
                                        LineHeight="1.2"
                                        Padding="20,10,20,0"
                                        Text="{Binding AdsDetails.AdsTitle}"
                                        TextColor="#44394a"
                                        VerticalTextAlignment="Center" />
                                    <StackLayout
                                        BackgroundColor="Transparent"
                                        Grid.Row="1"
                                        HorizontalOptions="Start"
                                        Padding="20,0,20,0"
                                        VerticalOptions="Start">

                                        <Label
                                            FontFamily="RajSemiBold"
                                            FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                            Small='12',
                                                                            Medium='12',
                                                                            ExtraSmall='10'}"
                                            Text="{Binding State, StringFormat='El estado: {0}'}"
                                            TextColor="red"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    <controls:ExpandParagraphControl
                                        BackgroundColor="Transparent"
                                        DefaultButtonTitle="Show more"
                                        DefaultVisibleLines="10"
                                        Grid.Row="2"
                                        IsVisible="{Binding DescriptionIsLonger}"
                                        Padding="20,20,20,20"
                                        Text="{Binding AdsMoreDetails.Description}" />
                                    <Label
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                        Small='10',
                                                                        Medium='10',
                                                                        ExtraSmall='10'}"
                                        Grid.Row="2"
                                        HorizontalTextAlignment="Start"
                                        IsVisible="{Binding DescriptionIsNoLonger}"
                                        Padding="20,15,20,15"
                                        Text="{Binding AdsMoreDetails.Description}" />
                                    <!--  Location start  -->
                                    <StackLayout BackgroundColor="Transparent" Grid.Row="3">
                                        <Grid
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="CenterAndExpand"
                                            Margin="0"
                                            Padding="0,20,0,20"
                                            VerticalOptions="CenterAndExpand"
                                            WidthRequest="300">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackLayout
                                                BackgroundColor="Transparent"
                                                Grid.Column="0"
                                                Grid.Row="0"
                                                HorizontalOptions="Start"
                                                Orientation="Horizontal">
                                                <Image
                                                    Aspect="AspectFit"
                                                    BackgroundColor="Transparent"
                                                    HeightRequest="20"
                                                    Source="{local:EmbeddedImage fileName=location_checkin.png}" />
                                                <Label
                                                    FontFamily="RajSemiBold"
                                                    FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                    Small='10',
                                                                                    Medium='10',
                                                                                    ExtraSmall='10'}"
                                                    HorizontalOptions="Start"
                                                    Padding="2,0,0,0"
                                                    Text="{Binding AdsDetails.CityFrom}"
                                                    TextColor="#44394a"
                                                    VerticalOptions="Center"
                                                    x:Name="label_start" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="go_to_maps_start" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                            <StackLayout
                                                BackgroundColor="Transparent"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Grid.Row="1"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Vertical">
                                                <Image
                                                    Aspect="AspectFit"
                                                    BackgroundColor="Transparent"
                                                    HeightRequest="1"
                                                    Source="{local:EmbeddedImage fileName=line_route.png}"
                                                    VerticalOptions="Start" />
                                                <Label
                                                    FontFamily="RajBold"
                                                    FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                    Small='8',
                                                                                    Medium='10',
                                                                                    ExtraSmall='8'}"
                                                    HeightRequest="15"
                                                    HorizontalOptions="Center"
                                                    Padding="0,2,0,0"
                                                    Text="Selecciona uno de ellos para ver la ubicación"
                                                    TextColor="#44394a"
                                                    VerticalOptions="Center" />
                                            </StackLayout>
                                            <StackLayout
                                                BackgroundColor="Transparent"
                                                Grid.Column="2"
                                                Grid.Row="0"
                                                HorizontalOptions="End"
                                                Orientation="Horizontal">
                                                <Label
                                                    FontFamily="RajSemiBold"
                                                    FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                    Small='10',
                                                                                    Medium='10',
                                                                                    ExtraSmall='10'}"
                                                    HorizontalOptions="End"
                                                    Padding="0,0,2,0"
                                                    Text="{Binding AdsDetails.CityTo, StringFormat='{0}'}"
                                                    TextColor="#44394a"
                                                    VerticalOptions="Center"
                                                    x:Name="label_end" />
                                                <Image
                                                    Aspect="AspectFit"
                                                    BackgroundColor="Transparent"
                                                    HeightRequest="20"
                                                    Source="{local:EmbeddedImage fileName=location_checkin.png}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="go_to_maps_end" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                    <!--  Location end  -->
                                    <!--  If is my ads - offers start  -->
                                    <StackLayout Grid.Row="4" IsVisible="{Binding AdsMoreDetails.IsMyAds}">
                                        <StackLayout>
                                            <Label
                                                BackgroundColor="Transparent"
                                                FontFamily="RajBold"
                                                FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                                Small='12',
                                                                                Medium='12',
                                                                                ExtraSmall='10'}"
                                                Padding="20,10,20,10"
                                                Text="{Binding OffersHeader}"
                                                TextColor="#44394a"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ShowHideCommand}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout BindableLayout.ItemsSource="{Binding OffersGroup}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <utils:NeatFrame
                                                        BackgroundColor="White"
                                                        BorderColor="LightGray"
                                                        CornerRadius="10"
                                                        Margin="10"
                                                        Padding="0">
                                                        <StackLayout>
                                                            <Grid
                                                                BackgroundColor="Transparent"
                                                                Margin="0,0,0,0"
                                                                Padding="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Image
                                                                    BackgroundColor="Transparent"
                                                                    Grid.Column="0"
                                                                    Grid.Row="0"
                                                                    Grid.RowSpan="2"
                                                                    HeightRequest="45"
                                                                    Source="{Binding UserProfilePhotoImg}"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="45" />
                                                                <Label
                                                                    BackgroundColor="Transparent"
                                                                    FontFamily="RajSemiBold"
                                                                    FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                    Small='10',
                                                                                                    Medium='10',
                                                                                                    ExtraSmall='10'}"
                                                                    Grid.Column="1"
                                                                    Grid.Row="0"
                                                                    Margin="12"
                                                                    Text="{Binding UserName}"
                                                                    TextColor="#44394a"
                                                                    VerticalOptions="End" />

                                                                <StackLayout
                                                                    BackgroundColor="Transparent"
                                                                    Grid.Column="1"
                                                                    Grid.Row="1"
                                                                    HorizontalOptions="Start"
                                                                    Margin="12,0,12,6"
                                                                    Orientation="Horizontal"
                                                                    VerticalOptions="Start">
                                                                    <Image
                                                                        Aspect="AspectFit"
                                                                        BackgroundColor="Transparent"
                                                                        HeightRequest="8"
                                                                        Source="{Binding UserStar1}" />
                                                                    <Image
                                                                        Aspect="AspectFit"
                                                                        BackgroundColor="Transparent"
                                                                        HeightRequest="8"
                                                                        Source="{Binding UserStar2}" />
                                                                    <Image
                                                                        Aspect="AspectFit"
                                                                        BackgroundColor="Transparent"
                                                                        HeightRequest="8"
                                                                        Source="{Binding UserStar3}" />
                                                                    <Image
                                                                        Aspect="AspectFit"
                                                                        BackgroundColor="Transparent"
                                                                        HeightRequest="8"
                                                                        Source="{Binding UserStar4}" />
                                                                    <Image
                                                                        Aspect="AspectFit"
                                                                        BackgroundColor="Transparent"
                                                                        HeightRequest="8"
                                                                        Source="{Binding UserStar5}" />
                                                                </StackLayout>

                                                                <Image
                                                                    Grid.Column="2"
                                                                    Grid.RowSpan="2"
                                                                    HeightRequest="25"
                                                                    Margin="0,0,25,0"
                                                                    Source="{local:EmbeddedImage fileName=inbox_menu.png}"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="25">
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>

                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding ShowHideCommand}" />
                                                                </Grid.GestureRecognizers>
                                                            </Grid>
                                                            <StackLayout BindableLayout.ItemsSource="{Binding GroupOffers}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackLayout>
                                                                            <Image
                                                                                Aspect="AspectFit"
                                                                                BackgroundColor="Transparent"
                                                                                HeightRequest="1"
                                                                                Margin="5,2,5,2"
                                                                                Source="{local:EmbeddedImage fileName=line_route.png}"
                                                                                VerticalOptions="CenterAndExpand" />
                                                                            <Label
                                                                                BackgroundColor="Transparent"
                                                                                FontFamily="RajRegular"
                                                                                FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                                Small='10',
                                                                                                                Medium='10',
                                                                                                                ExtraSmall='10'}"
                                                                                HorizontalOptions="StartAndExpand"
                                                                                Margin="0"
                                                                                Padding="20,5,0,0"
                                                                                Text="{Binding CreatedAt, Converter={StaticResource cnvDateTimeConverter}}"
                                                                                TextColor="#44394a"
                                                                                VerticalOptions="StartAndExpand" />
                                                                            <Label
                                                                                FontSize="Small"
                                                                                HorizontalOptions="Center"
                                                                                HorizontalTextAlignment="Center"
                                                                                IsVisible="{Binding AcceptRejectCancelBtnVisibility}"
                                                                                Margin="10,10,10,5"
                                                                                VerticalOptions="Center">
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <FormattedString.Spans>
                                                                                            <Span Text="Tienes una oferta de " />
                                                                                            <Span
                                                                                                FontAttributes="Bold"
                                                                                                Text="{Binding Price, StringFormat='{0:0.##} €'}"
                                                                                                TextColor="Black" />
                                                                                        </FormattedString.Spans>
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                            <Label
                                                                                FontSize="Small"
                                                                                HorizontalOptions="Center"
                                                                                HorizontalTextAlignment="Center"
                                                                                IsVisible="{Binding RejectedOfferVisibility}"
                                                                                Margin="10,10,10,5"
                                                                                VerticalOptions="Center">
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <FormattedString.Spans>
                                                                                            <Span Text="Has " />
                                                                                            <Span
                                                                                                FontAttributes="Bold"
                                                                                                Text=" rechazado "
                                                                                                TextColor="Red" />
                                                                                            <Span Text=" esta oferta de " />
                                                                                            <Span FontAttributes="Bold" Text="{Binding Price, StringFormat='{0:0.##} €'}" />
                                                                                        </FormattedString.Spans>
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                            <Label
                                                                                FontSize="Small"
                                                                                HorizontalOptions="Center"
                                                                                IsVisible="{Binding AcceptedOfferVisibility}"
                                                                                Margin="10,10,10,5"
                                                                                VerticalOptions="Center">
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <FormattedString.Spans>
                                                                                            <Span Text="Has " />
                                                                                            <Span
                                                                                                FontAttributes="Bold"
                                                                                                Text=" aceptado "
                                                                                                TextColor="Green" />
                                                                                            <Span Text=" esta oferta de " />
                                                                                            <Span FontAttributes="Bold" Text="{Binding Price, StringFormat='{0:0.##} €'}" />
                                                                                        </FormattedString.Spans>
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                            <Label
                                                                                FontSize="Small"
                                                                                HorizontalOptions="Center"
                                                                                HorizontalTextAlignment="Center"
                                                                                IsVisible="{Binding CanceledOfferVisibility}"
                                                                                Margin="10,10,10,5"
                                                                                VerticalOptions="Center">
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <FormattedString.Spans>
                                                                                            <Span Text="Esta oferta de " />
                                                                                            <Span FontAttributes="Bold" Text="{Binding Price, StringFormat='{0:0.##} €'}" />
                                                                                            <Span Text=" fue " />
                                                                                            <Span
                                                                                                FontAttributes="Bold"
                                                                                                Text=" cancelada "
                                                                                                TextColor="Orange" />
                                                                                            <Span Text=" por el remitente.. " />
                                                                                        </FormattedString.Spans>
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                            <!--<Button
                                                                IsVisible="{Binding ChatBtnVisibility}"
                                                    Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"
                                                    HeightRequest="35"
                                                    WidthRequest="120"
                                                    Margin="12,0,12,12"
                                                    Padding="0"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="Fill"
                                                    FontFamily="RajSemiBold"
                                                    BackgroundColor="#44394a"
                                                    FontSize="12"  TextColor="White"
                                                    Text="Open CHAT" />-->

                                                                            <Button
                                                                                BackgroundColor="#44394a"
                                                                                Command="{Binding PaymentCommand}"
                                                                                FontFamily="RajSemiBold"
                                                                                FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                                Small='10',
                                                                                                                Medium='10',
                                                                                                                ExtraSmall='10'}"
                                                                                Grid.Column="0"
                                                                                Grid.ColumnSpan="2"
                                                                                HeightRequest="35"
                                                                                HorizontalOptions="Fill"
                                                                                IsVisible="{Binding PaymentBtnVisibility}"
                                                                                Margin="12,0,12,12"
                                                                                Padding="0"
                                                                                Text="Ir a Pagar"
                                                                                TextColor="White"
                                                                                VerticalOptions="Center"
                                                                                WidthRequest="120" />
                                                                            <Grid Padding="0,10,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition />
                                                                                    <ColumnDefinition />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button
                                                                                    BackgroundColor="#44394a"
                                                                                    Command="{Binding GenerateProofCommand}"
                                                                                    FontFamily="RajSemiBold"
                                                                                    FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                                    Small='10',
                                                                                                                    Medium='10',
                                                                                                                    ExtraSmall='10'}"
                                                                                    Grid.Column="0"
                                                                                    HeightRequest="35"
                                                                                    HorizontalOptions="Fill"
                                                                                    IsVisible="{Binding GeneratePDFVisibility}"
                                                                                    Margin="10"
                                                                                    Padding="0"
                                                                                    Text="Passing Car Factura"
                                                                                    TextColor="White"
                                                                                    VerticalOptions="Center"
                                                                                    WidthRequest="120" />
                                                                                <Button
                                                                                    BackgroundColor="#44394a"
                                                                                    Command="{Binding StripeProofCommand}"
                                                                                    FontFamily="RajSemiBold"
                                                                                    FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                                    Small='10',
                                                                                                                    Medium='10',
                                                                                                                    ExtraSmall='10'}"
                                                                                    Grid.Column="1"
                                                                                    HeightRequest="35"
                                                                                    HorizontalOptions="Fill"
                                                                                    IsVisible="{Binding GeneratePDFVisibility}"
                                                                                    Margin="10"
                                                                                    Padding="0"
                                                                                    Text="Stripe Facturación"
                                                                                    TextColor="White"
                                                                                    VerticalOptions="Center" />
                                                                            </Grid>
                                                                            <!--<Button
                                                                                                    IsVisible="{Binding AbortBtnVisibility}"
                                                                                                                        Command="{Binding AbortCommand}"
                                                                                        Grid.Column="0"
                                                                                        Grid.ColumnSpan="2"
                                                                                        Grid.Row="4"
                                                                                        HeightRequest="35"
                                                                                        Margin="10,0,10,10"
                                                                                        Padding="0"
                                                                                        HorizontalOptions="Fill"
                                                                                        VerticalOptions="Fill"
                                                                                        FontFamily="RajSemiBold"
                                                                                        BackgroundColor="#ff1a21"
                                                                                        FontSize="12"  TextColor="White"
                                                                                xct:TouchEffect.NativeAnimation="True"
                                                                                        Text="CANCEL" />-->
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition />
                                                                                    <ColumnDefinition />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button
                                                                                    BackgroundColor="#1892df"
                                                                                    Command="{Binding AcceptCommand}"
                                                                                    FontFamily="RajSemiBold"
                                                                                    FontSize="{markups:OnScreenSize DefaultSize='10',
                                                                                                                    Small='8',
                                                                                                                    Medium='9',
                                                                                                                    ExtraSmall='8'}"
                                                                                    HeightRequest="35"
                                                                                    HorizontalOptions="Fill"
                                                                                    IsVisible="{Binding AcceptRejectCancelBtnVisibility}"
                                                                                    Margin="10"
                                                                                    Padding="0"
                                                                                    Text="Aceptar"
                                                                                    TextColor="White"
                                                                                    VerticalOptions="Center" />
                                                                                <Button
                                                                                    BackgroundColor="#ff1a21"
                                                                                    Command="{Binding RejectCommand}"
                                                                                    FontFamily="RajSemiBold"
                                                                                    FontSize="{markups:OnScreenSize DefaultSize='10',
                                                                                                                    Small='8',
                                                                                                                    Medium='9',
                                                                                                                    ExtraSmall='8'}"
                                                                                    Grid.Column="1"
                                                                                    HeightRequest="35"
                                                                                    HorizontalOptions="Fill"
                                                                                    IsVisible="{Binding AcceptRejectCancelBtnVisibility}"
                                                                                    Margin="10"
                                                                                    Padding="0"
                                                                                    Text="Rechazar"
                                                                                    TextColor="White"
                                                                                    VerticalOptions="Center" />
                                                                            </Grid>
                                                                        </StackLayout>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </utils:NeatFrame>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>
                                    </StackLayout>

                                    <StackLayout Grid.Row="4" IsVisible="{Binding IsNotMyAds}">
                                        <StackLayout IsVisible="{Binding NewOfferVisibility}" x:Name="SendOffersBtnsSP">
                                            <Grid
                                                BackgroundColor="Transparent"
                                                Margin="-10,0,0,0"
                                                Padding="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackLayout
                                                    BackgroundColor="Transparent"
                                                    Grid.Column="0"
                                                    Grid.Row="0"
                                                    HorizontalOptions="End"
                                                    Orientation="Horizontal"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontFamily="RajSemiBold"
                                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                                        Small='12',
                                                                                        Medium='12',
                                                                                        ExtraSmall='10'}"
                                                        Text="{Binding AdsDetails.AdsPrice}"
                                                        TextColor="#44394a"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label
                                                        FontFamily="RajSemiBold"
                                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                                        Small='12',
                                                                                        Medium='12',
                                                                                        ExtraSmall='10'}"
                                                        Text="€"
                                                        TextColor="#44394a"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Column="1"
