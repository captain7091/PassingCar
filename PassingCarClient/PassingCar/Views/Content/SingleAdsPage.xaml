                                                VerticalOptions="Center"
                                                WidthRequest="25">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                        <StackLayout BindableLayout.ItemsSource="{Binding SentOffers}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <StackLayout BackgroundColor="Transparent">

                                                        <Image
                                                            Aspect="AspectFit"
                                                            BackgroundColor="Transparent"
                                                            HeightRequest="1"
                                                            Margin="5,2,5,2"
                                                            Source="{local:EmbeddedImage fileName=line_route.png}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            BackgroundColor="Transparent"
                                                            FontFamily="RajRegular"
                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                            Small='10',
                                                                                            Medium='10',
                                                                                            ExtraSmall='10'}"
                                                            HorizontalOptions="StartAndExpand"
                                                            Margin="10,10,10,5"
                                                            Padding="20,0,20,0"
                                                            Text="{Binding CreatedAt, Converter={StaticResource cnvDateTimeConverter}}"
                                                            TextColor="#44394a"
                                                            VerticalOptions="StartAndExpand" />
                                                        <Label
                                                            FontSize="Small"
                                                            HorizontalOptions="Center"
                                                            HorizontalTextAlignment="Center"
                                                            IsVisible="{Binding AcceptRejectCancelBtnVisibility}"
                                                            Margin="10,0,10,5"
                                                            VerticalOptions="Center">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <FormattedString.Spans>
                                                                        <Span FontSize="{markups:OnScreenSize DefaultSize='12', Small='10', Medium='10', ExtraSmall='10'}" Text="Enviaste un " />
                                                                        <Span
                                                                            FontAttributes="Bold"
                                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                            Small='10',
                                                                                                            Medium='10',
                                                                                                            ExtraSmall='10'}"
                                                                            Text="{Binding Price, StringFormat='{0:0.00} €'}"
                                                                            TextColor="Black" />
                                                                        <Span FontSize="{markups:OnScreenSize DefaultSize='12', Small='10', Medium='10', ExtraSmall='10'}" Text=" oferta " />
                                                                    </FormattedString.Spans>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <Label
                                                            FontSize="Small"
                                                            HorizontalOptions="Center"
                                                            HorizontalTextAlignment="Center"
                                                            IsVisible="{Binding RejectedOfferVisibility}"
                                                            Margin="10,0,10,10"
                                                            VerticalOptions="Center">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <FormattedString.Spans>
                                                                        <Span FontSize="{markups:OnScreenSize DefaultSize='12', Small='10', Medium='10', ExtraSmall='10'}" Text="Su oferta de " />
                                                                        <Span
                                                                            FontAttributes="Bold"
                                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                            Small='10',
                                                                                                            Medium='10',
                                                                                                            ExtraSmall='10'}"
                                                                            Text="{Binding Price, StringFormat='{0:0.00} €'}" />
                                                                        <Span FontSize="{markups:OnScreenSize DefaultSize='12', Small='10', Medium='10', ExtraSmall='10'}" Text=" fue " />
                                                                        <Span
                                                                            FontAttributes="Bold"
                                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                            Small='10',
                                                                                                            Medium='10',
                                                                                                            ExtraSmall='10'}"
                                                                            Text=" rechazada "
                                                                            TextColor="Red" />
                                                                        <Span FontSize="{markups:OnScreenSize DefaultSize='12', Small='10', Medium='10', ExtraSmall='10'}" Text="." />
                                                                    </FormattedString.Spans>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <Label
                                                            FontSize="Small"
                                                            HorizontalOptions="Center"
                                                            IsVisible="{Binding AcceptedOfferVisibility}"
                                                            VerticalOptions="Center">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <FormattedString.Spans>
                                                                        <Span FontSize="{markups:OnScreenSize DefaultSize='12', Small='10', Medium='10', ExtraSmall='10'}" Text="Your " />
                                                                        <Span
                                                                            FontAttributes="Bold"
                                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                            Small='10',
                                                                                                            Medium='10',
                                                                                                            ExtraSmall='10'}"
                                                                            Text="{Binding Price, StringFormat='{0:0.00} €'}" />
                                                                        <Span FontSize="{markups:OnScreenSize DefaultSize='12', Small='10', Medium='10', ExtraSmall='10'}" Text=" offer was" />
                                                                        <Span
                                                                            FontAttributes="Bold"
                                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                            Small='10',
                                                                                                            Medium='10',
                                                                                                            ExtraSmall='10'}"
                                                                            Text=" accepted "
                                                                            TextColor="Green" />
                                                                        <Span Text="." />
                                                                    </FormattedString.Spans>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <Label
                                                            FontSize="Small"
                                                            HorizontalOptions="Center"
                                                            HorizontalTextAlignment="Center"
                                                            IsVisible="{Binding CanceledOfferVisibility}"
                                                            Margin="10,0,10,10"
                                                            VerticalOptions="Center">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <FormattedString.Spans>
                                                                        <Span
                                                                            FontAttributes="Bold"
                                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                            Small='10',
                                                                                                            Medium='10',
                                                                                                            ExtraSmall='10'}"
                                                                            Text="Cancelaste "
                                                                            TextColor="Orange" />
                                                                        <Span FontSize="{markups:OnScreenSize DefaultSize='12', Small='10', Medium='10', ExtraSmall='10'}" Text=" esta oferta de " />
                                                                        <Span
                                                                            FontAttributes="Bold"
                                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                                            Small='10',
                                                                                                            Medium='10',
                                                                                                            ExtraSmall='10'}"
                                                                            Text="{Binding Price, StringFormat='{0:0.00} €'}" />
                                                                    </FormattedString.Spans>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <Button
                                                            BackgroundColor="Orange"
                                                            Command="{Binding CancelCommand}"
                                                            FontFamily="RajSemiBold"
                                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                            Small='10',
                                                                                            Medium='10',
                                                                                            ExtraSmall='10'}"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Grid.Row="3"
                                                            HeightRequest="35"
                                                            HorizontalOptions="Fill"
                                                            IsVisible="{Binding AcceptRejectCancelBtnVisibility}"
                                                            Margin="12,0,12,12"
                                                            Padding="0"
                                                            Text="CANCELAR OFERTA"
                                                            TextColor="Black"
                                                            VerticalOptions="Center"
                                                            WidthRequest="120" />
                                                    </StackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>

                                    </StackLayout>
                                    <!--  If is my ads - offers end  -->
                                    <!--  If is not my ads - offers send start  -->
                                    <!--  If is not my ads - offers send start  -->
                                    <!--  If is not my ads - Sender Details  -->
                                    <StackLayout
                                        BackgroundColor="Transparent"
                                        Grid.Row="5"
                                        IsVisible="{Binding IsNotMyAds}">
                                        <Label
                                            BackgroundColor="Transparent"
                                            FontFamily="RajBold"
                                            FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                            Small='12',
                                                                            Medium='12',
                                                                            ExtraSmall='10'}"
                                            HorizontalOptions="Start"
                                            Padding="20,20,20,0"
                                            Text="Datos del remitente"
                                            TextColor="#44394a"
                                            VerticalOptions="CenterAndExpand" />
                                        <Image
                                            Aspect="AspectFit"
                                            BackgroundColor="Transparent"
                                            HeightRequest="1"
                                            Margin="0,-3,0,10"
                                            Source="{local:EmbeddedImage fileName=line_route.png}"
                                            VerticalOptions="CenterAndExpand" />

                                        <Label
                                            BackgroundColor="Transparent"
                                            FontFamily="RajBold"
                                            FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                            Small='12',
                                                                            Medium='12',
                                                                            ExtraSmall='10'}"
                                            Padding="20,10,20,10"
                                            Text="{Binding UserTypeText}"
                                            TextColor="#44394a"
                                            VerticalOptions="CenterAndExpand" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Column="0"
                                                Grid.Row="0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal"
                                                Padding="40,10,20,10">
                                                <Frame
                                                    BorderColor="Gray"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    HorizontalOptions="Center"
                                                    IsClippedToBounds="True"
                                                    Margin="0,0,0,0"
                                                    Padding="0"
                                                    VerticalOptions="Start"
                                                    WidthRequest="40">
                                                    <Image
                                                        Aspect="AspectFit"
                                                        BackgroundColor="Transparent"
                                                        HeightRequest="40"
                                                        Source="{Binding AdsDetails.UserProfilePhotoImg}"
                                                        VerticalOptions="CenterAndExpand"
                                                        WidthRequest="40" />

                                                </Frame>

                                                <StackLayout
                                                    BackgroundColor="Transparent"
                                                    Margin="5,0,0,0"
                                                    Orientation="Vertical">
                                                    <Label
                                                        BackgroundColor="Transparent"
                                                        FontFamily="RajBold"
                                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                                        Small='12',
                                                                                        Medium='12',
                                                                                        ExtraSmall='10'}"
                                                        HorizontalOptions="StartAndExpand"
                                                        Text="{Binding AdsDetails.UserName}"
                                                        TextColor="#44394a"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label
                                                        BackgroundColor="Transparent"
                                                        FontFamily="RajSemiBold"
                                                        FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                        Small='10',
                                                                                        Medium='10',
                                                                                        ExtraSmall='10'}"
                                                        HorizontalOptions="StartAndExpand"
                                                        Text="{Binding JuridicCIF}"
                                                        TextColor="Gray"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                            </StackLayout>
                                            <StackLayout
                                                BackgroundColor="Transparent"
                                                Grid.Column="1"
                                                Grid.Row="0"
                                                Margin="5,0,0,0"
                                                Orientation="Vertical"
                                                VerticalOptions="Center">
                                                <StackLayout
                                                    BackgroundColor="Transparent"
                                                    HorizontalOptions="Start"
                                                    Orientation="Horizontal"
                                                    Padding="20,10,10,0"
                                                    VerticalOptions="Center">
                                                    <Image
                                                        Aspect="AspectFit"
                                                        BackgroundColor="Transparent"
                                                        HeightRequest="13"
                                                        Source="{Binding AdsDetails.UserStar1}" />
                                                    <Image
                                                        Aspect="AspectFit"
                                                        BackgroundColor="Transparent"
                                                        HeightRequest="13"
                                                        Source="{Binding AdsDetails.UserStar2}" />
                                                    <Image
                                                        Aspect="AspectFit"
                                                        BackgroundColor="Transparent"
                                                        HeightRequest="13"
                                                        Source="{Binding AdsDetails.UserStar3}" />
                                                    <Image
                                                        Aspect="AspectFit"
                                                        BackgroundColor="Transparent"
                                                        HeightRequest="13"
                                                        Source="{Binding AdsDetails.UserStar4}" />
                                                    <Image
                                                        Aspect="AspectFit"
                                                        BackgroundColor="Transparent"
                                                        HeightRequest="13"
                                                        Source="{Binding AdsDetails.UserStar5}" />
                                                </StackLayout>
                                                <Label
                                                    BackgroundColor="Transparent"
                                                    FontFamily="RajRegular"
                                                    FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                                    Small='10',
                                                                                    Medium='10',
                                                                                    ExtraSmall='10'}"
                                                    HorizontalOptions="Start"
                                                    Margin="0"
                                                    Padding="20,0,40,10"
                                                    Text="{Binding AdsDetails.RatingString, StringFormat='{0}'}"
                                                    TextColor="#44394a"
                                                    VerticalOptions="Center" />
                                            </StackLayout>
                                        </Grid>
                                        <Image
                                            Aspect="AspectFit"
                                            BackgroundColor="Transparent"
                                            Grid.ColumnSpan="3"
                                            Grid.Row="1"
                                            HeightRequest="10"
                                            Source="{local:EmbeddedImage fileName=line_route.png}"
                                            VerticalOptions="CenterAndExpand" />

                                    </StackLayout>
                                    <!--  If is not my ads - Sender Details  -->
                                    <!--  ID and Views Start  -->
                                    <Button
                                        BackgroundColor="DarkRed"
                                        Command="{Binding DisableCommand}"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                        Small='10',
                                                                        Medium='10',
                                                                        ExtraSmall='10'}"
                                        Grid.Row="6"
                                        HeightRequest="35"
                                        HorizontalOptions="Fill"
                                        IsVisible="{Binding DisableBtnVisibility}"
                                        Margin="12,0,12,12"
                                        Padding="0"
                                        Text="DESACTIVAR ANUNCIO"
                                        TextColor="White"
                                        VerticalOptions="Center"
                                        WidthRequest="120" />
                                    <Button
                                        BackgroundColor="DarkGreen"
                                        Command="{Binding RepostCommand}"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                        Small='10',
                                                                        Medium='10',
                                                                        ExtraSmall='10'}"
                                        Grid.Row="6"
                                        HeightRequest="35"
                                        HorizontalOptions="EndAndExpand"
                                        IsVisible="{Binding RepostBtnVisibility}"
                                        Margin="50,0,12,12"
                                        Padding="0"
                                        Text="ACTIVAR ANUNCIO"
                                        TextColor="White"
                                        VerticalOptions="Center"
                                        WidthRequest="120" />
                                    <Grid Grid.Row="7" Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            BackgroundColor="Transparent"
                                            FontFamily="RajRegular"
                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                            Small='10',
                                                                            Medium='10',
                                                                            ExtraSmall='10'}"
                                            Grid.Column="0"
                                            Text="{Binding AdsDetails.AdsId, StringFormat='ID: {0}'}"
                                            TextColor="Gray"
                                            VerticalOptions="CenterAndExpand" />
                                        <Label
                                            BackgroundColor="Transparent"
                                            FontFamily="RajRegular"
                                            FontSize="{markups:OnScreenSize DefaultSize='12',
                                                                            Small='10',
                                                                            Medium='10',
                                                                            ExtraSmall='10'}"
                                            Grid.Column="1"
                                            Text="{Binding AdsMoreDetails.ViewCounter, StringFormat='Visto: {0}'}"
                                            TextColor="gray"
                                            VerticalOptions="CenterAndExpand" />
                                    </Grid>
                                    <!--  ID and Views End  -->
                                </Grid>
                            </StackLayout>
                        </utils:NeatFrame>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <Grid
                AbsoluteLayout.LayoutBounds="0,0,1,0.08"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="Transparent"
                Margin="0,0,0,0"
                x:Name="grid_context">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
            <utils:NeatFrame
                AbsoluteLayout.LayoutBounds="0.02,0.01,0.13,0.05"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                CornerRadius="25"
                Margin="0">
                <utils:NeatFrame.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="0, 0, 0, 0" />
                            <On Platform="Android" Value="0, 0, 0, 0" />
                            <On Platform="UWP" Value="0, 0, 0, 0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </utils:NeatFrame.Padding>
                <Image
                    HeightRequest="12"
                    HorizontalOptions="StartAndExpand"
                    Source="{local:EmbeddedImage fileName=back_arrow.png}"
                    VerticalOptions="CenterAndExpand"
                    x:Name="menu_context">
                    <Image.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <OnPlatform.Platforms>
                                <On Platform="iOS" Value="20, 0, 0, 0" />
                                <On Platform="Android" Value="20, 0, 0, 0" />
                                <On Platform="UWP" Value="20, 0, 0, 0" />
                            </OnPlatform.Platforms>
                        </OnPlatform>
                    </Image.Margin>
                </Image>
                <utils:NeatFrame.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="Backward" />
                </utils:NeatFrame.GestureRecognizers>
            </utils:NeatFrame>
        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>