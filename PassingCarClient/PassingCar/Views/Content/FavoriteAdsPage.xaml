<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PassingCar.Extensions"
             
             xmlns:controls="clr-namespace:PassingCar.Views" xmlns:utils="clr-namespace:PassingCar.Utils"
             x:Class="PassingCar.Views.FavoriteAdsPage"
             xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar"
             BackgroundColor="White">
    <ContentPage.Content>
        <AbsoluteLayout BackgroundColor="Transparent" x:Name="favoritespage">
            <CollectionView
               x:Name="listview_favorites"
               AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All"
               SelectionMode="None"
               Margin="0,100,0,0"
               Scrolled="collectionview_ads_Scrolled"
               BackgroundColor="White" 
             
               ItemsSource="{Binding Adss}"
               >
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <ContentView >
                            <utils:NeatFrame CornerRadius="15"
                                   Opacity="{Binding NeatFrameOpacity}"
                           Padding="0"
                           Margin="15, 8, 15, 8">
                                <Grid Padding="0" BackgroundColor="Transparent" Margin="10, 8, 10, 8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition  />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!--<StackLayout BackgroundColor="Transparent" VerticalOptions="Start" HorizontalOptions="Start" Padding="0, 5, 0, 0" Grid.Column="0" Grid.Row="0">
                                <Label VerticalOptions="CenterAndExpand" FontFamily="RajSemiBold" FontSize="12"  TextColor="Red" Text="{Binding Ads.State, StringFormat='State: {0}' }" />
                            </StackLayout>-->
                                    <StackLayout BackgroundColor="Transparent" VerticalOptions="Start" HorizontalOptions="End" Padding="0, 5, 5, 0" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
                                        <Image HeightRequest="12" BackgroundColor="Transparent" Source="{Binding FavoriteImage}" Aspect="AspectFit" >
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding AddToFavorite}"></TapGestureRecognizer>
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </StackLayout>

                                    <Label  Grid.ColumnSpan="2" 
                                Grid.Row="0"
                                        FontFamily="RajRegular"
                                        FontSize="{markups:OnScreenSize DefaultSize='12' , Small='10', Medium='10',  ExtraSmall='10'}"
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="StartAndExpand"
                                        Text="{Binding PostedTime, Converter={StaticResource cnvDateTimeConverter}}" 
                                        BackgroundColor="Transparent" 
                                        TextColor="Black"
                                        Margin="0"                                   
                                        Padding="10, 0, 0, 0"/>
                                    <StackLayout 
                                Orientation="Vertical"
                                BackgroundColor="Transparent" 
                                VerticalOptions="CenterAndExpand" 
                                HorizontalOptions="CenterAndExpand" 
                                Padding="0" Grid.Column="0" 
                                Grid.Row="1" Grid.RowSpan="3">
                                        <Grid HorizontalOptions="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image WidthRequest="100" HeightRequest="75" BackgroundColor="Transparent" Source="{Binding FirstImage}" Aspect="AspectFit" />
                                            <utils:NeatFrame Grid.Column="0"  IsVisible="{Binding AdIsNotEnabled}"
                                             Grid.Row="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" 
                                           Background="White" Opacity="0.5"
                                           />
                                        </Grid>
                                        <Label 
                                        Padding="0, 10, 0, 0" 
                                        HorizontalOptions="CenterAndExpand" 
                                        VerticalOptions="CenterAndExpand" 
                                        BackgroundColor="Transparent"
                                        TextColor="#44394a"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}" Text="{Binding AdsPrice, StringFormat='{0:0.00} €'}" />
                                    </StackLayout>
                                    <StackLayout VerticalOptions="CenterAndExpand"  Padding="10, 5, 10, 0"  Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2">
                                        <Label  
                                    FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}" 
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="CenterAndExpand"
                                    FontFamily="RajSemiBold"
                                    HeightRequest="30"
                                    TextColor="#44394a"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding AdsTitle, StringFormat='{0}'}" />
                                        <Grid Padding="0, 10, 0, 0" BackgroundColor="Transparent" Margin="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition  />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <StackLayout Spacing="5" BackgroundColor="Transparent" Grid.Column="0" Grid.Row="0" Orientation="Horizontal" HorizontalOptions="Start">
                                                <Image BackgroundColor="Transparent" HeightRequest="15" Source="{local:EmbeddedImage fileName=location_checkin.png}" Aspect="AspectFit" />
                                                <Label FontFamily="RajBold" HeightRequest="15" HorizontalOptions="Start" FontSize="{markups:OnScreenSize DefaultSize='10' , Small='8', Medium='9',  ExtraSmall='8'}" Text="{Binding CityFrom, StringFormat='{0}'}" />
                                            </StackLayout>
                                            <Image Grid.Column="0" HeightRequest="5" VerticalOptions="StartAndExpand" Grid.ColumnSpan="3" Grid.Row="1" BackgroundColor="Transparent" Source="{local:EmbeddedImage fileName=line_route.png}" Aspect="AspectFit" />
                                            <StackLayout Spacing="5" Margin="-10,0,0,0" BackgroundColor="Transparent" Grid.Column="2" Grid.Row="0" Orientation="Horizontal" HorizontalOptions="End">
                                                <Label FontFamily="RajBold" HorizontalOptions="End" FontSize="{markups:OnScreenSize DefaultSize='10' , Small='8', Medium='9',  ExtraSmall='8'}"  Text="{Binding CityTo, StringFormat='{0}'}" />
                                                <Image BackgroundColor="Transparent" HeightRequest="15" Source="{local:EmbeddedImage fileName=location_checkin.png}" Aspect="AspectFit" />
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                    <Grid Margin="10, 0, 10, 5" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" BackgroundColor="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition  />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Grid.Column="0" Grid.ColumnSpan="2">
                                            <Frame HeightRequest="14" VerticalOptions="Start"
                   WidthRequest="20"
                   CornerRadius="10"
                   HorizontalOptions="Start"
                   IsClippedToBounds="True"
                   Padding="0"
                   BorderColor="Gray"
                   Margin="0,0,3,0">
                                            <Image BackgroundColor="Transparent" HorizontalOptions="Center" HeightRequest="20" WidthRequest="20" Margin="0" Source="{Binding UserProfilePhotoImg}" Aspect="AspectFill"/>

                                                    </Frame> <Label FontSize="{markups:OnScreenSize DefaultSize='10' , Small='8', Medium='9',  ExtraSmall='8'}" TextColor="#44394a" FontFamily="RajSemiBold" VerticalOptions="Center" Margin="0" BackgroundColor="Transparent" Text="{Binding UserName}" />
                                        </StackLayout>
                                        <StackLayout Margin="0, 0, 0, 0" BackgroundColor="Transparent" Orientation="Horizontal" HorizontalOptions="EndAndExpand" VerticalOptions="Center" Grid.Column="1" Grid.ColumnSpan="3">
                                            <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar1}" Aspect="AspectFit" />
                                            <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar2}" Aspect="AspectFit" />
                                            <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar3}" Aspect="AspectFit" />
                                            <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar4}" Aspect="AspectFit" />
                                            <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar5}" Aspect="AspectFit" />
                                        </StackLayout>
                                    </Grid>
                                    <Label Text="" IsVisible="{Binding AdIsNotEnabled}" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Grid.RowSpan="4" Grid.ColumnSpan="3" FontAttributes="Bold,Italic" TextColor="Black" FontSize="{markups:OnScreenSize DefaultSize='20' , Small='18', Medium='18',  ExtraSmall='16'}"/>
                                </Grid>
                                <utils:NeatFrame.GestureRecognizers>
        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>

    </utils:NeatFrame.GestureRecognizers>
                            </utils:NeatFrame>
                        </ContentView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <controls:LoadingSmall 
                    IsVisible="True"
                        VerticalOptions="StartAndExpand"
                        BackgroundColor="Transparent" HeightRequest="70" x:Name="SmallLoading">
                    </controls:LoadingSmall>

                </CollectionView.Footer>
            </CollectionView>
            <Grid x:Name="grid_context" Margin="0,0,0,0" AbsoluteLayout.LayoutBounds="0,0,1,0.09" AbsoluteLayout.LayoutFlags="All" BackgroundColor="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
            </Grid>
            <utils:NeatFrame AbsoluteLayout.LayoutBounds="0,0,0.13,0.08" AbsoluteLayout.LayoutFlags="All"
                   Padding="0" Margin="0" CornerRadius="25"
                   BorderColor="Transparent"
                   BackgroundColor="Transparent">
                <Image
                    x:Name="menu_context"    
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="StartAndExpand"
                    BackgroundColor="Transparent"
                    Source="{local:EmbeddedImage fileName=back_arrow.png}"
                    HeightRequest="12"
                    Aspect="AspectFit"
                    >
                    <Image.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <OnPlatform.Platforms>
                                <On Platform="iOS" Value="20, 0, 0, 0" />
                                <On Platform="Android" Value="20, 0, 0, 0" />
                                <On Platform="UWP" Value="20, 0, 0, 0" />
                            </OnPlatform.Platforms>
                        </OnPlatform>
                    </Image.Margin>
                </Image>
                <utils:NeatFrame.GestureRecognizers>
                    <TapGestureRecognizer
                             Tapped="Backward"
                             NumberOfTapsRequired="1" />
                </utils:NeatFrame.GestureRecognizers>
            </utils:NeatFrame>
            <Label
                AbsoluteLayout.LayoutBounds="0,0,1,0.09" AbsoluteLayout.LayoutFlags="All"
                x:Name="hello_context"
                Text="Favoritos,"
                BackgroundColor="Transparent"
                VerticalOptions="CenterAndExpand"
                HorizontalTextAlignment="Center"
                HorizontalOptions="EndAndExpand"
                FontSize="25"
                TextColor="#b4b4b1"
                FontFamily="RajBold"
                >
                <Label.Margin>
                    <OnPlatform x:TypeArguments="Thickness">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="0, 0, 20, 0" />
                            <On Platform="Android" Value="0, 40, 0, 0" />
                            <On Platform="UWP" Value="0, 0, 40, 0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </Label.Margin>
            </Label>
        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>