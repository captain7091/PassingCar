            <Grid
                x:Name="grid_context"
                Margin="0,0,0,0"
                AbsoluteLayout.LayoutBounds="0,0,1,0.08"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
            <utils:NeatFrame
                Margin="0"
                Padding="0"
                AbsoluteLayout.LayoutBounds="0,0,0.13,0.08"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                CornerRadius="25">
                <Image
                    x:Name="menu_context"
                    Aspect="AspectFit"
                    BackgroundColor="Transparent"
                    HeightRequest="12"
                    HorizontalOptions="StartAndExpand"
                    Source="{local:EmbeddedImage fileName=back_arrow.png}"
                    VerticalOptions="CenterAndExpand">
                    <Image.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <OnPlatform.Platforms>
                                <On Platform="iOS" Value="20, 0, 0, 0" />
                                <On Platform="Android" Value="20, 0, 0, 0" />
                                <On Platform="UWP" Value="20, 0, 0, 0" />
                            </OnPlatform.Platforms>
                        </OnPlatform>
                    </Image.Margin>
                </Image>
                <utils:NeatFrame.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="Backward" />
                </utils:NeatFrame.GestureRecognizers>
            </utils:NeatFrame>
            <Label
                x:Name="hello_context"
                AbsoluteLayout.LayoutBounds="0,0,1,0.08"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="Transparent"
                FontFamily="RajBold"
                FontSize="25"
                HorizontalOptions="EndAndExpand"
                HorizontalTextAlignment="Center"
                Text="Publicar Anuncio,"
                TextColor="#b4b4b1"
                VerticalOptions="CenterAndExpand">
                <Label.Margin>
                    <OnPlatform x:TypeArguments="Thickness">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="0, 0, 20, 0" />
                            <On Platform="Android" Value="0, 40, 0, 0" />
                            <On Platform="UWP" Value="0, 0, 40, 0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </Label.Margin>
            </Label>

            <Grid
                x:Name="grid_footer_context"
                Margin="0,0,0,0"
                AbsoluteLayout.LayoutBounds="0,1,1,0.09"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
            <Button
                Margin="30,0,0,0"
                AbsoluteLayout.LayoutBounds="0,1,1,0.09"
                AbsoluteLayout.LayoutFlags="All"
