<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PassingCar.Views.AddAds"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:PassingCar.Extensions.Behaviors"
    xmlns:local="clr-namespace:PassingCar.Extensions"
    xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar"
    xmlns:utils="clr-namespace:PassingCar.Utils"
    xmlns:controls="clr-namespace:PassingCar.Views"
    xmlns:xct1="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="baseStyle" TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="Micro" />
                <Setter Property="FontAttributes" Value="Italic" />
            </Style>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleImage" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style TargetType="Image">
                        <Setter Property="HeightRequest" Value="20" />
                        <Setter Property="Source" Value="{local:EmbeddedImage fileName=error.png}" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>
                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style TargetType="Image">
                        <Setter Property="HeightRequest" Value="20" />
                        <Setter Property="Source" Value="{local:EmbeddedImage fileName=success.png}" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>
            </behaviors:BooleanToObjectConverter>



            <behaviors:BooleanToObjectConverter x:Key="boolToStyleEmail" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="Enter a valid email" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="Your email looks good" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleTitle" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="El título debe contener entre 8 y 50 caracteres." />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="Looks good." />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleDescription" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="*mín. 20 caracteres y máximo 800 caracteres." />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="Perfect fit." />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStylePrice" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="Establece tu Precio para el transporte *min.10€" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="Perfect." />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleLength" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>
            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleWidth" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>
            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleHeight" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>
            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleWeight" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>
            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleAge" x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style BasedOn="{StaticResource baseStyle}" TargetType="Label">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <behaviors:GenderConverter x:Key="genderConverter" />

            <Style x:Key="InvalidEntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="Red" />
            </Style>

            <Style x:Key="InvalidLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="Red" />
            </Style>

            <Style x:Key="ValidEntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="Gray" />
                <Setter Property="Text" Value="Eres muy joven!" />
            </Style>

            <Style x:Key="ValidLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="Green" />
                <Setter Property="Text" Value="Eres muy joven!" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <AbsoluteLayout x:Name="addads_page" BackgroundColor="White">
            <ScrollView
                x:Name="myscrollview"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                Scrolled="OnScrolled">
                <Grid Padding="20,80,20,120" BackgroundColor="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Label
                        x:Name="title_head"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="0,0,0,0"
                        BackgroundColor="Transparent"
                        FontFamily="RajBold"
                        FontSize="{markups:OnScreenSize DefaultSize='16',
                                                        Small='14',
                                                        Medium='14',
                                                        ExtraSmall='12'}"
                        HorizontalOptions="CenterAndExpand"
                        Text="Título:"
                        TextColor="Black"
                        VerticalOptions="CenterAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="0,0,20,0"
                        BackgroundColor="Transparent"
                        Orientation="Horizontal"
                        VerticalOptions="StartAndExpand">
                        <Entry
                            x:Name="title"
                            Margin="0,0,0,0"
                            BackgroundColor="Transparent"
                            FontFamily="RajSemiBold"
                            FontSize="{markups:OnScreenSize DefaultSize='14',
                                                            Small='12',
                                                            Medium='12',
                                                            ExtraSmall='10'}"
                            HeightRequest="40"
                            HorizontalOptions="FillAndExpand"
                            IsEnabled="{Binding IsFormEnabled}"
                            Placeholder="Título del Anuncio ..."
                            Text="{Binding Title}"
                            VerticalOptions="FillAndExpand" />
                        <Image x:Name="emailSuccessErrorImage" HeightRequest="18" />
                    </StackLayout>
                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="3">
                        <Label
                            FontAttributes="Italic"
                            FontFamily="RajSemiBold"
                            FontSize="11" />
                    </StackLayout>

                    <StackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="0,30,0,10"
                        HorizontalOptions="CenterAndExpand"
                        Orientation="Horizontal"
                        Spacing="25">
                        <Image
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="45"
                            Source="{Binding ImageSource1}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding InsertPhoto1Commad}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Image
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="45"
                            Source="{Binding ImageSource2}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding InsertPhoto2Commad}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Image
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="45"
                            Source="{Binding ImageSource3}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding InsertPhoto3Commad}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Image
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="45"
                            Source="{Binding ImageSource4}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding InsertPhoto4Commad}" />
                            </Image.GestureRecognizers>
                        </Image>

                    </StackLayout>
                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        HorizontalOptions="CenterAndExpand">
                        <Label
                            FontAttributes="Italic"
                            FontFamily="RajSemiBold"
                            FontSize="11"
                            Text="Puedes subir hasta 4 fotos a máxima resolución." />

                    </StackLayout>

                    <StackLayout
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="10,20,0,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical">
                        <Label
                            x:Name="description_head"
                            BackgroundColor="Transparent"
                            FontFamily="RajBold"
                            FontSize="{markups:OnScreenSize DefaultSize='16',
                                                            Small='14',
                                                            Medium='14',
                                                            ExtraSmall='12'}"
                            Text="Descripción:"
                            TextColor="Black" />

                    </StackLayout>
                    <StackLayout
                        Grid.Row="5"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="10,0,10,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical">
                        <Editor
                            x:Name="description"
                            BackgroundColor="LightGray"
                            FontFamily="RajSemiBold"
                            FontSize="{markups:OnScreenSize DefaultSize='14',
                                                            Small='12',
                                                            Medium='12',
                                                            ExtraSmall='10'}"
                            HeightRequest="100"
                            IsEnabled="{Binding IsFormEnabled}"
                            Placeholder="Sobre el Anuncio ..."
                            Text="{Binding Description}"
                            TextColor="Black" />
                        <Label
                            Margin="0,5,0,0"
                            FontAttributes="Italic"
                            FontFamily="RajSemiBold"
                            FontSize="11"
                            HorizontalOptions="CenterAndExpand" />
                        <Label
                            FontAttributes="Italic"
                            FontFamily="RajSemiBold"
                            FontSize="11"
                            HorizontalOptions="CenterAndExpand"
                            Text="*No use caracteres especiales y más de 5 números." />
                    </StackLayout>

                    <StackLayout
                        Grid.Row="6"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="30,20,30,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical">
                        <utils:NeatFrame BorderColor="LightGray" CornerRadius="10">
                            <StackLayout>
                                <Label
                                    BackgroundColor="Transparent"
                                    FontFamily="RajBold"
                                    FontSize="{markups:OnScreenSize DefaultSize='16',
                                                                    Small='14',
                                                                    Medium='14',
                                                                    ExtraSmall='12'}"
                                    Text="Desde:"
                                    TextColor="Black" />
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Vertical"
                                    Spacing="0">
                                    <Label
                                        x:Name="fromaddress_head"
                                        Margin="0,10,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Dirección Completa: "
                                        TextColor="Black" />
                                    <Entry
                                        x:Name="fromaddress"
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        Placeholder="Max 50 ch ..."
                                        Text="{Binding FromAddress}" />
                                    <Label
                                        x:Name="fromcity_head"
                                        Margin="0,10,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Ciudad: "
                                        TextColor="Black" />
                                    <Entry
                                        x:Name="fromcity"
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        Placeholder="Max 20 ch ..."
                                        Text="{Binding FromCity}"
                                        WidthRequest="150" />
                                    <Label
                                        x:Name="fromzipcode_head"
                                        Margin="0,10,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Código Postal: "
                                        TextColor="Black" />
                                    <Entry
                                        x:Name="fromzipcode"
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        Placeholder="xxxxx"
                                        Text="{Binding FromZIPCode}"
                                        WidthRequest="80"
                                        Keyboard="Numeric"
                                        MaxLength="5" />
                                    <Label
                                        x:Name="provincia_head"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Provincia:"
                                        VerticalOptions="CenterAndExpand" />
                                    <Picker
                                        x:Name="provincie_picker_from"
                                        Title="Tu Provincia                  "
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        SelectedItem="{Binding ProvinceFrom}"
                                        TitleColor="Black" />
                                    <Label
                                        x:Name="from_number_head"
                                        Margin="0,10,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Número Teléfono Remitente: "
                                        TextColor="Black" />
                                    <Entry
                                        x:Name="from_number"
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        Keyboard="Telephone"
                                        Placeholder="(+xx) xxx xxx xxx"
                                        Text="{Binding FromPhoneNumber}"
                                        TextChanged="from_number_TextChanged"
                                        WidthRequest="100" />
                                    <Label
                                        x:Name="from_number_warning"
                                        Margin="0,5,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='10',
                                                                        Small='8',
                                                                        Medium='10',
                                                                        ExtraSmall='8'}"
                                        HorizontalOptions="CenterAndExpand"
                                        IsVisible="false"
                                        Text="*formato inválido"
                                        TextColor="#FE3F40" />
                                </StackLayout>
                            </StackLayout>
                        </utils:NeatFrame>

                    </StackLayout>

                    <StackLayout
                        Grid.Row="7"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="30,20,30,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical">
                        <utils:NeatFrame BorderColor="LightGray" CornerRadius="10">
                            <StackLayout>
                                <Label
                                    BackgroundColor="Transparent"
                                    FontFamily="RajBold"
                                    FontSize="{markups:OnScreenSize DefaultSize='16',
                                                                    Small='14',
                                                                    Medium='14',
                                                                    ExtraSmall='12'}"
                                    Text="Destino:"
                                    TextColor="Black" />
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Vertical"
                                    Spacing="0">
                                    <Label
                                        x:Name="toaddress_head"
                                        Margin="0,10,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Dirección Completa: "
                                        TextColor="Black" />
                                    <Entry
                                        x:Name="toaddress"
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        Placeholder="Max 50 ch ..."
                                        Text="{Binding ToAddress}" />
                                    <Label
                                        x:Name="tocity_head"
                                        Margin="0,10,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Ciudad: "
                                        TextColor="Black" />
                                    <Entry
                                        x:Name="tocity"
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        Placeholder="Max 20 ch ..."
                                        Text="{Binding ToCity}"
                                        WidthRequest="150" />
                                    <Label
                                        x:Name="tozipcode_head"
                                        Margin="0,10,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Código Postal: "
                                        TextColor="Black" />
                                    <Entry
                                        x:Name="tozipcode"
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        Placeholder="xxxxx"
                                        Text="{Binding ToZIPCode}"
                                        WidthRequest="80"
                                        Keyboard="Numeric"
                                        MaxLength="5" />
                                    <Label
                                        x:Name="provincia_to_head"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Provincia:"
                                        VerticalOptions="CenterAndExpand" />
                                    <Picker
                                        x:Name="provincie_picker_to"
                                        Title="Su Provincia                  "
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        SelectedItem="{Binding ProvinceTo}"
                                        TitleColor="Black" />
                                    <Label
                                        x:Name="dest_number_head"
                                        Margin="0,10,0,0"
                                        FontFamily="RajSemiBold"
                                        FontSize="{markups:OnScreenSize DefaultSize='14',
                                                                        Small='12',
                                                                        Medium='12',
                                                                        ExtraSmall='10'}"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Número Teléfono Destinatario: "
                                        TextColor="Black" />
                                    <Entry
                                        x:Name="dest_number"
                                        Margin="0,0,0,0"
                                        BackgroundColor="Transparent"
                                        FontFamily="RajSemiBold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        Keyboard="Telephone"
                                        Placeholder="(+xx) xxx xxx xxx"
                                        TextChanged="dest_number_TextChanged"
                                        Text="{Binding ToPhoneNumber}"
                                        WidthRequest="100" />
                                    <Label
                                        x:Name="dest_number_warning"
                                        Margin="0,5,0,0"
                                        FontFamily="RajSemiBold"
