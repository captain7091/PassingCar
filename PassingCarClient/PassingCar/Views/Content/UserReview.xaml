<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PassingCar.Views.UserReview"
            
             xmlns:local="clr-namespace:PassingCar.Extensions"
             xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar"
             xmlns:behaviors="clr-namespace:PassingCar.Extensions.Behaviors" xmlns:utils="clr-namespace:PassingCar.Utils" xmlns:xct1="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="Transparent">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="baseStyle"
             TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="Micro" />
                <Setter Property="FontAttributes" Value="Italic" />
            </Style>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleImage"
                                              x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style TargetType="Image">
                        <Setter Property="HeightRequest" Value="20" />
                        <Setter Property="Source" Value="{local:EmbeddedImage fileName=error.png}" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>
                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style TargetType="Image">
                        <Setter Property="HeightRequest" Value="20" />
                        <Setter Property="Source" Value="{local:EmbeddedImage fileName=success.png}" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>
            </behaviors:BooleanToObjectConverter>



            <behaviors:BooleanToObjectConverter x:Key="boolToStyleEmail"
                                           x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style TargetType="Label" BasedOn="{StaticResource baseStyle}">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="Enter a valid email" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style TargetType="Label" BasedOn="{StaticResource baseStyle}">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="Your email looks good" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <behaviors:BooleanToObjectConverter x:Key="boolToStyleAge"
                                           x:TypeArguments="Style">
                <behaviors:BooleanToObjectConverter.FalseObject>
                    <Style TargetType="Label" BasedOn="{StaticResource baseStyle}">
                        <Setter Property="TextColor" Value="#FE3F40" />
                        <Setter Property="Text" Value="Enter numeric values" />
                    </Style>
                </behaviors:BooleanToObjectConverter.FalseObject>

                <behaviors:BooleanToObjectConverter.TrueObject>
                    <Style TargetType="Label" BasedOn="{StaticResource baseStyle}">
                        <Setter Property="TextColor" Value="#4CAF50" />
                        <Setter Property="Text" Value="Eres muy joven!" />
                    </Style>
                </behaviors:BooleanToObjectConverter.TrueObject>

            </behaviors:BooleanToObjectConverter>

            <behaviors:GenderConverter x:Key="genderConverter" />

            <Style x:Key="InvalidEntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="Red" />
            </Style>

            <Style x:Key="InvalidLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="Red" />
            </Style>

            <Style x:Key="ValidEntryStyle"
               TargetType="Entry">
                <Setter Property="TextColor" Value="Gray"/>
                <Setter Property="Text" Value="Eres muy joven!" />
            </Style>

            <Style x:Key="ValidLabelStyle"
               TargetType="Label">
                <Setter Property="TextColor" Value="Green"/>
                <Setter Property="Text" Value="Eres muy joven!" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <utils:NeatFrame 
                HorizontalOptions="Center"
                VerticalOptions="Center"
                CornerRadius="15"
                Padding="20, 20, 20, 30"
                Margin="0, 0, 0, 0"
                BackgroundColor="LightGray">
            <StackLayout 
                VerticalOptions="Center"
                HorizontalOptions="Center"
                BackgroundColor="Transparent"
                >
                <utils:NeatFrame
                   HorizontalOptions="End"
                   Padding="0" Margin="0,0,0,0" CornerRadius="25"
                   BorderColor="Transparent"
                   BackgroundColor="Transparent">
                    <Image
                    x:Name="menu_context"                   
                    Margin="0, 0, 0, 0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="Transparent"
                    Source="{local:EmbeddedImage fileName=x-symbol.png}"
                    HeightRequest="15"
                    Aspect="AspectFit"
                    >
                    </Image>
                    <utils:NeatFrame.GestureRecognizers>
                        <TapGestureRecognizer
                             Tapped="Close_PopUp"
                             NumberOfTapsRequired="1" />
                    </utils:NeatFrame.GestureRecognizers>
                </utils:NeatFrame>
                <Label 
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    Text="Give us a Review for User: " 
                    Margin="0, 10, 0, 0"
                    FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                    FontFamily="RajSemiBold"
                />
                <Label 
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    Text="User" 
                    Margin="0, 0, 0, 20"
                    FontSize="{markups:OnScreenSize DefaultSize='18' , Small='16', Medium='16',  ExtraSmall='14'}"
                    TextColor="#FE3F40"
                    FontFamily="RajSemiBold"
                        x:Name="userName"
                />
                <StackLayout Orientation="Horizontal" HeightRequest="40" HorizontalOptions="CenterAndExpand">
                    <Grid>
                        <Grid.Behaviors>
                            <behaviors:StarBehavior x:Name="starOne" GroupName="myStar"/>
                        </Grid.Behaviors>
                        <Image x:Name="starBlankOne"
                                    Source="{local:EmbeddedImage fileName=star_outline.png}" />

                        <Image x:Name="starSelectedOne"
                                    Source="{local:EmbeddedImage fileName=star_selected.png}"
                                    IsVisible="{Binding Source={x:Reference starOne},
                                        Path=IsStarred}"/>
                    </Grid>
                    <Grid >
                        <Grid.Behaviors>
                            <behaviors:StarBehavior x:Name="starTwo" GroupName="myStar"/>
                        </Grid.Behaviors>
                        <Image x:Name="starBlankTwo"
                                    Source="{local:EmbeddedImage fileName=star_outline.png}" />

                        <Image x:Name="starSelectedTwo"
                                    Source="{local:EmbeddedImage fileName=star_selected.png}"
                                     IsVisible="{Binding Source={x:Reference starTwo},
                                        Path=IsStarred}"/>
                    </Grid>
                    <Grid >
                        <Grid.Behaviors>
                            <behaviors:StarBehavior x:Name="starThree" GroupName="myStar"/>
                        </Grid.Behaviors>
                        <Image x:Name="starBlankThree"
                                    Source="{local:EmbeddedImage fileName=star_outline.png}" />

                        <Image x:Name="starSelectedThree"
                                    Source="{local:EmbeddedImage fileName=star_selected.png}"
                                    IsVisible="{Binding Source={x:Reference starThree},
                                        Path=IsStarred}"/>
                    </Grid>
                    <Grid >
                        <Grid.Behaviors>
                            <behaviors:StarBehavior x:Name="starFour" GroupName="myStar"/>
                        </Grid.Behaviors>
                        <Image x:Name="starBlankFour"
                                    Source="{local:EmbeddedImage fileName=star_outline.png}" />

                        <Image x:Name="starSelectedFour"
                                    Source="{local:EmbeddedImage fileName=star_selected.png}"
                                    IsVisible="{Binding Source={x:Reference starFour},
                                        Path=IsStarred}"/>
                    </Grid>
                    <Grid >
                        <Grid.Behaviors>
                            <behaviors:StarBehavior x:Name="starFive" GroupName="myStar"/>
                        </Grid.Behaviors>
                        <Image x:Name="starBlankFive"
                                    Source="{local:EmbeddedImage fileName=star_outline.png}" />

                        <Image x:Name="starSelectedFive"
                                    Source="{local:EmbeddedImage fileName=star_selected.png}"
                                    IsVisible="{Binding Source={x:Reference starFive},
                                        Path=IsStarred}"/>
                    </Grid>
                </StackLayout>
                <StackLayout
                        Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" 
                        HorizontalOptions="FillAndExpand"
                        Margin="10,20,10,20"
                        Orientation="Vertical"
                        BackgroundColor="Transparent">
                    <Editor                          
                                    BackgroundColor="White"
                                    Placeholder="Leave a review..."
                                    FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                                    HeightRequest="100"
                                    FontFamily="RajSemiBold"
                                    TextColor="Black"   
                            x:Name="ReviewText"
                                    >
                        <Editor.Behaviors>
                            <xct1:CharactersValidationBehavior 
                                                      CharacterType="Any"
                                                      IsValid="False"
                                                      MaximumLength="200"
                                                      MinimumLength="14" x:Name="validator_editor"/>
                        </Editor.Behaviors>

                        <!--<VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Valid">
                                    <VisualState.Setters>
                                        <Setter Property="TextColor" Value="Gray"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Invalid">
                                    <VisualState.Setters>
                                        <Setter Property="TextColor" Value="IndianRed"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>-->
                    </Editor>
                    <Label 
                                HorizontalOptions="CenterAndExpand"
                                Text="*don't use special characters and more than 5 number." 
                                FontSize="11"
                                FontAttributes="Italic"
                                FontFamily="RajSemiBold"
                                />
                    <Label 
                                HorizontalOptions="CenterAndExpand"
                                Text="*min. 20 characters" 
                                FontSize="11"
                                FontAttributes="Italic"
                                FontFamily="RajSemiBold"
                                />
                </StackLayout>
                <Button
                    Margin="0, 10, 0, 10"
                    WidthRequest="120"
                    Text="Review"
                    TextColor="White"
                    CharacterSpacing="0"
                    FontFamily="RajSemiBold"
                    FontSize="{markups:OnScreenSize DefaultSize='14' , Small='12', Medium='12',  ExtraSmall='10'}"
                    CornerRadius="15"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    BackgroundColor="#FE3F40"
                    HeightRequest="35"
                    Clicked="CheckReview"
                    >
                </Button>
            </StackLayout>
        </utils:NeatFrame>
    </ContentView.Content>
</ContentView>