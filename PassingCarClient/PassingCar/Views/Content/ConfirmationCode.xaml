<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:PassingCar.Extensions"
             x:Class="PassingCar.Views.Content.ConfirmationCode">
    <ContentView.Content>
        <Grid Padding="70,10,70,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:CustomEntry x:Name="step1" TextChanged="step1_TextChanged" Grid.Column="0"  Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" BackgroundColor="#e5e5e5" TextColor="Black" FontFamily="fontbold"/>
            <local:CustomEntry x:Name="step2" TextChanged="step2_TextChanged" Grid.Column="1" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" BackgroundColor="#e5e5e5" TextColor="Black" FontFamily="fontbold"/>
            <local:CustomEntry x:Name="step3" TextChanged="step3_TextChanged" Grid.Column="2"   Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" BackgroundColor="#e5e5e5" TextColor="Black" FontFamily="fontbold"/>
            <local:CustomEntry x:Name="step4" TextChanged="step4_TextChanged" Grid.Column="3" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" BackgroundColor="#e5e5e5" TextColor="Black" FontFamily="fontbold"/>
            <local:CustomEntry x:Name="step5" TextChanged="step5_TextChanged" Grid.Column="4" Keyboard="Numeric" MaxLength="1" HorizontalTextAlignment="Center" BackgroundColor="#e5e5e5" TextColor="Black" FontFamily="fontbold"/>
        </Grid>
    </ContentView.Content>
</ContentView>