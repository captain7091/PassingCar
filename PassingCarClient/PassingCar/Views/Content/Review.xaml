<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:markups="clr-namespace:PassingCar;assembly=PassingCar"
             x:Class="PassingCar.Views.Content.Review">
    <ContentView.Content>
        <Grid Margin="10, 0, 10, 5" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition  />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackLayout Orientation="Horizontal" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" Grid.Column="0" Grid.ColumnSpan="2">
                <Image BackgroundColor="Transparent" HeightRequest="12" WidthRequest="17" Margin="0" Source="{Binding UserProfilePhotoImg}"/>
                <Label FontSize="{markups:OnScreenSize DefaultSize='10' , Small='8', Medium='9',  ExtraSmall='8'}" TextColor="#44394a" FontFamily="RajSemiBold" VerticalOptions="Center" Margin="0" BackgroundColor="Transparent" Text="{Binding UserName}" />
            </StackLayout>
            <StackLayout Margin="0, 0, 0, 0" Spacing="5" BackgroundColor="Transparent" Orientation="Horizontal" HorizontalOptions="EndAndExpand" VerticalOptions="Center" Grid.Column="2">
                <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar1}" Aspect="AspectFit" />
                <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar2}" Aspect="AspectFit" />
                <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar3}" Aspect="AspectFit" />
                <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar4}" Aspect="AspectFit" />
                <Image HeightRequest="8" BackgroundColor="Transparent" Source="{Binding UserStar5}" Aspect="AspectFit" />
            </StackLayout>
            <Label FontSize="{markups:OnScreenSize DefaultSize='10' , Small='8', Medium='9',  ExtraSmall='8'}" TextColor="#44394a" FontFamily="RajSemiBold" Grid.Row="1" VerticalOptions="Center" Grid.Column="0" Grid.ColumnSpan="3" Margin="0" BackgroundColor="Transparent" Text="{Binding Message}" />

            <BoxView HeightRequest="1" VerticalOptions="Center" Grid.ColumnSpan="3" BackgroundColor="LightGray" Grid.Row="2" />
        </Grid>
    </ContentView.Content>
</ContentView>